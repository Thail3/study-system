{"nodes": [{"id": "src_content_module_15_02_ubiquitous_language_doc", "label": "Ubiquitous Language (note)", "file_type": "document", "source_file": "src/content/module-15/02-ubiquitous-language.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_15_02_ubiquitous_language_ubiquitous_language", "label": "Ubiquitous Language", "file_type": "concept", "source_file": "src/content/module-15/02-ubiquitous-language.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One vocabulary shared by domain experts, docs and code removes the translation layer; bugs live in the gap where e.g. status 4 means different things to different people, so code is refactored whenever business vocabulary shifts."}, {"id": "src_content_module_15_02_ubiquitous_language_bounded_context", "label": "Bounded Context", "file_type": "concept", "source_file": "src/content/module-15/02-ubiquitous-language.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ubiquitous Language is only consistent inside one Bounded Context; 'order' in Sales (price, discount) differs from 'order' in Shipping (address, tracking)."}, {"id": "src_content_module_15_02_ubiquitous_language_domain_expert", "label": "Domain Expert", "file_type": "concept", "source_file": "src/content/module-15/02-ubiquitous-language.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_15_02_ubiquitous_language_generic_status_code", "label": "Generic setStatus(order, 4) Anti-pattern", "file_type": "rationale", "source_file": "src/content/module-15/02-ubiquitous-language.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Magic status codes force a translation layer and cause misinterpretation bugs; new hires need a human translator."}, {"id": "src_content_module_15_02_ubiquitous_language_intent_revealing_names", "label": "Business-term Names (cancelOrder, OrderCancelled)", "file_type": "concept", "source_file": "src/content/module-15/02-ubiquitous-language.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_15_02_ubiquitous_language_adr_ubiquitous", "label": "ADR: Refactor OrderService to Ubiquitous Language", "file_type": "concept", "source_file": "src/content/module-15/02-ubiquitous-language.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accepted: readable code mapping to business talk, at the cost of refactoring all call sites and renaming when vocabulary changes."}], "edges": [{"source": "src_content_module_15_02_ubiquitous_language_doc", "target": "src_content_module_15_02_ubiquitous_language_ubiquitous_language", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-15/02-ubiquitous-language.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_15_02_ubiquitous_language_ubiquitous_language", "target": "src_content_module_15_02_ubiquitous_language_domain_expert", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-15/02-ubiquitous-language.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_15_02_ubiquitous_language_ubiquitous_language", "target": "src_content_module_15_02_ubiquitous_language_bounded_context", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-15/02-ubiquitous-language.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_15_02_ubiquitous_language_ubiquitous_language", "target": "src_content_module_15_02_ubiquitou