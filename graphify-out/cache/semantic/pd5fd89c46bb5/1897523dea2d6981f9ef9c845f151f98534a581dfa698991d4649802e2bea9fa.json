{"nodes": [{"id": "src_content_module_04_04_sharding", "label": "Sharding", "file_type": "document", "source_file": "src/content/module-04/04-sharding.md"}, {"id": "src_content_module_04_04_sharding_sharding", "label": "Sharding", "file_type": "concept", "source_file": "src/content/module-04/04-sharding.md"}, {"id": "src_content_module_04_04_sharding_range_based", "label": "Range-based sharding", "file_type": "concept", "source_file": "src/content/module-04/04-sharding.md", "rationale": "simple but one shard can become overloaded when new keys cluster in one range (e.g. ever-increasing user ids)"}, {"id": "src_content_module_04_04_sharding_hash_based", "label": "Hash-based sharding", "file_type": "concept", "source_file": "src/content/module-04/04-sharding.md"}, {"id": "src_content_module_04_04_sharding_directory_based", "label": "Directory-based sharding", "file_type": "concept", "source_file": "src/content/module-04/04-sharding.md", "rationale": "a lookup table records which key lives on which shard so any key can be moved freely; costs an extra lookup hop and the directory itself must scale and tolerate failure"}, {"id": "src_content_module_04_04_sharding_sharding_key", "label": "Sharding key selection", "file_type": "concept", "source_file": "src/content/module-04/04-sharding.md", "rationale": "pick a key most queries already filter by (e.g. user_id)"}, {"id": "src_content_module_04_04_sharding_cross_shard_query", "label": "Cross-shard query and JOIN problem", "file_type": "concept", "source_file": "src/content/module-04/04-sharding.md"}, {"id": "src_content_module_04_04_sharding_hot_shard", "label": "Hot shard", "file_type": "concept", "source_file": "src/content/module-04/04-sharding.md", "rationale": "even key counts do not guarantee even traffic; monitor per-shard traffic and rebalance hot keys"}, {"id": "src_content_module_04_04_sharding_sharding_vs_replication", "label": "Sharding vs replication", "file_type": "concept", "source_file": "src/content/module-04/04-sharding.md", "rationale": "replication copies the same data (read scale, fault tolerance) while sharding splits different data (storage and write scale); real systems use both"}, {"id": "src_content_module_04_04_sharding_mod_rehash_problem", "label": "Mod-N rehash moves almost every key", "file_type": "concept", "source_file": "src/content/module-04/04-sharding.md"}, {"id": "src_content_module_04_04_sharding_shard_router_demo", "label": "ShardRouterDemo", "file_type": "code", "source_file": "src/content/module-04/04-sharding.md"}], "edges": [{"source": "src_content_module_04_04_sharding", "target": "src_content_module_04_03_replication", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-04/04-sharding.md", "weight": 1.0}, {"source": "src_content_module_04_04_sharding", "target": "src_content_module_04_04_sharding_sharding", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-04/04-sharding.md", "weight": 1.0}, {"source": "src_content_module_04_04_sharding", "target": "src_content_module_04_04_sharding_shard_router_demo", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-04/04-sharding.md", "weight": 1.0}, {"source": "src_content_module_04_04_sharding_sharding", "target": "src_content_module_04_04_sharding_range_based", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-04/04-sharding.md", "weight": 1.0}, {"source": "src_content_module_04_04_sharding_sharding", "target": "src_content_module_04_04_sharding_hash_based", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-04/04-sharding.md", "weight": 1.0}, {"source": "src_content_module_04_04_sharding_sharding", "target": "src_content_module_04_04_sharding_directory_based", "relation": "references", "confide