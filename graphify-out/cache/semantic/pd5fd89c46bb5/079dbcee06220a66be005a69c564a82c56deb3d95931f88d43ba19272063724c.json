{"nodes": [{"id": "src_content_module_32_02_promql_basics_promql", "label": "PromQL", "file_type": "concept", "source_file": "src/content/module-32/02-promql-basics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_32_02_promql_basics_instant_vector", "label": "Instant Vector", "file_type": "concept", "source_file": "src/content/module-32/02-promql-basics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_32_02_promql_basics_range_vector", "label": "Range Vector", "file_type": "concept", "source_file": "src/content/module-32/02-promql-basics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A set of samples over a window (e.g. [5m]); not a single number so it must pass through a function like rate()."}, {"id": "src_content_module_32_02_promql_basics_rate", "label": "rate() / increase()", "file_type": "concept", "source_file": "src/content/module-32/02-promql-basics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "rate() gives per-second average increase and automatically compensates for counter resets; increase() gives the total increase. Always wrap Counters in rate()."}, {"id": "src_content_module_32_02_promql_basics_histogram_quantile", "label": "histogram_quantile()", "file_type": "concept", "source_file": "src/content/module-32/02-promql-basics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_32_02_promql_basics_rate_on_gauge_mistake", "label": "Using rate() on a Gauge (mistake)", "file_type": "rationale", "source_file": "src/content/module-32/02-promql-basics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null,