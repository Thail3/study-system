{"nodes": [{"id": "src_content_module_06_02_message_queue_message_queue", "label": "Message Queue", "file_type": "concept", "source_file": "src/content/module-06/02-message-queue.md", "source_location": null, "rationale": "FIFO buffer between producer and consumer so both sides run at different speeds; consumers can be scaled horizontally and queued work survives a consumer failure. Examples: RabbitMQ, AWS SQS, Redis Streams."}, {"id": "src_content_module_06_02_message_queue_producer_consumer", "label": "Producer and Consumer", "file_type": "concept", "source_file": "src/content/module-06/02-message-queue.md", "source_location": null}, {"id": "src_content_module_06_02_message_queue_at_least_once", "label": "At-Least-Once Delivery", "file_type": "concept", "source_file": "src/content/module-06/02-message-queue.md", "source_location": null, "rationale": "If a consumer disappears before ACK the message is redelivered, so work may run twice; handlers should be idempotent (set status = paid, not add money)."}, {"id": "src_content_module_06_02_message_queue_ack", "label": "ACK (Acknowledgement)", "file_type": "concept", "source_file": "src/content/module-06/02-message-queue.md", "source_location": null}, {"id": "src_content_module_06_02_message_queue_dual_write_problem", "label": "Dual Write Problem", "file_type": "concept", "source_file": "src/content/module-06/02-message-queue.md", "source_location": null, "rationale": "Saving to the database and publishing to a queue are two separate writes; a crash between them leaves an order saved but nobody notified."}, {"id": "src_content_module_06_02_message_queue_transactional_outbox", "label": "Transactional Outbox Pattern", "file_type": "rationale", "source_file": "src/content/module-06/02-message-queue.md", "source_location": null, "rationale": "Write an outbox row in the same DB transaction as the business data, and have a relay process publish it to the queue later, retrying safely because the record persists."}], "edges": 