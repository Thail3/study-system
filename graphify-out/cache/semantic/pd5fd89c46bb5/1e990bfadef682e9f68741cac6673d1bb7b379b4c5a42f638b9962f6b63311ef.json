{"nodes": [{"id": "src_content_module_52_02_immutable_infrastructure", "label": "Immutable Infrastructure (lesson)", "file_type": "document", "source_file": "src/content/module-52/02-immutable-infrastructure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_52_02_immutable_infrastructure_pets_vs_cattle", "label": "Pets vs Cattle", "file_type": "rationale", "source_file": "src/content/module-52/02-immutable-infrastructure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pets are individually tended mutable servers that are hard to recover; cattle are interchangeable instances built from one image and replaced rather than repaired."}, {"id": "src_content_module_52_02_immutable_infrastructure_immutable_infrastructure", "label": "Immutable Infrastructure", "file_type": "rationale", "source_file": "src/content/module-52/02-immutable-infrastructure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Build a new image per change, create new instances, destroy old ones, never SSH-patch; gives easy rollback and cross-environment consistency."}, {"id": "src_content_module_52_02_immutable_infrastructure_mutable_infrastructure", "label": "Mutable Infrastructure (Pet Servers)", "file_type": "concept", "source_file": "src/content/module-52/02-immutable-infrastructure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_52_02_immutable_infrastructure_snowflake_server", "label": "Snowflake Server", "file_type": "concept", "source_file": "src/content/module-52/02-immutable-infrastructure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_52_02_immutable_infrastructure_config_drift", "label": "Config Drift of Pet Servers", "file_type": "rationale", "source_file": "src/content/module-52/02-immutable-infrastructure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accumulated manual patches over months make a server unreproducible; config management reduces but does not eliminate this because it still mutates the same machine."}, {"id": "src_content_module_52_02_immutable_infrastructure_config_management", "label": "Config Management (Ansible, Chef, Puppet)", "file_type": "concept", "source_file": "src/content/module-52/02-immutable-infrastructure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_52_02_immutable_infrastructure_image_based_deployment", "label": "Image-based Deployment (Docker, Packer, AMI)", "file_type": "concept", "source_file": "src/content/module-52/02-immutable-infrastructure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_52_02_immutable_infrastructure_hybrid_config_mgmt_at_build_time", "label": "Config Management at Image Build Time", "file_type": "rationale", "source_file": "src/content/module-52/02-immutable-infrastructure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same tool (Ansible) works either way; the snowflake problem is whether running instances are edited, not the tool. Use config management to build clean images, then never modify running instances."}], "edges": [{"source": "src_content_module_52_02_immutable_infrastructure", "target": "src_content_module_52_02_immutable_infrastructure_pets_vs_cattle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-52/02-immutable-infrastructure.md", "source_location": null, "weight": 1.0}, {"source": "src_c