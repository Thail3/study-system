{"nodes": [{"id": "src_content_module_03_03_eviction_policy", "label": "Eviction policy", "file_type": "document", "source_file": "src/content/module-03/03-eviction-policy.md"}, {"id": "src_content_module_03_03_eviction_policy_eviction_policy", "label": "Eviction policy", "file_type": "concept", "source_file": "src/content/module-03/03-eviction-policy.md"}, {"id": "src_content_module_03_03_eviction_policy_lru", "label": "LRU (Least Recently Used)", "file_type": "concept", "source_file": "src/content/module-03/03-eviction-policy.md", "rationale": "assumes that what nobody touched recently is unlikely to be needed soon"}, {"id": "src_content_module_03_03_eviction_policy_lfu", "label": "LFU (Least Frequently Used)", "file_type": "concept", "source_file": "src/content/module-03/03-eviction-policy.md"}, {"id": "src_content_module_03_03_eviction_policy_fifo", "label": "FIFO eviction", "file_type": "concept", "source_file": "src/content/module-03/03-eviction-policy.md"}, {"id": "src_content_module_03_03_eviction_policy_ttl_based", "label": "TTL-based expiry", "file_type": "concept", "source_file": "src/content/module-03/03-eviction-policy.md"}, {"id": "src_content_module_03_03_eviction_policy_redis_maxmemory_policy", "label": "Redis maxmemory-policy (allkeys-lru / allkeys-lfu)", "file_type": "concept", "source_file": "src/content/module-03/03-eviction-policy.md"}, {"id": "src_content_module_03_03_eviction_policy_approximate_lru", "label": "Approximate LRU (Redis sampling)", "file_type": "concept", "source_file": "src/content/module-03/03-eviction-policy.md", "rationale": "true LRU needs the access order of every key (too much overhead); Redis samples a few keys (default 5) and evicts the least recently used among them, trading accuracy for speed"}, {"id": "src_content_module_03_03_eviction_policy_cache_pollution_scan", "label": "Cache pollution from a one-time scan", "file_type": "concept", "source_file": "src/content/module-03/03-eviction-policy.md", "rationale": "a one-o