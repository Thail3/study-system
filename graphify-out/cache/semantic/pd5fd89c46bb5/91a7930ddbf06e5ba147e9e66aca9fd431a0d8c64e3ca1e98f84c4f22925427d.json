{"nodes": [{"id": "src_content_module_08_03_retry_backoff_retry", "label": "Retry", "file_type": "concept", "source_file": "src/content/module-08/03-retry-backoff.md", "source_location": null, "rationale": "Retry only transient errors (timeouts, 503), never definite failures like 400 or 401."}, {"id": "src_content_module_08_03_retry_backoff_exponential_backoff", "label": "Exponential Backoff", "file_type": "rationale", "source_file": "src/content/module-08/03-retry-backoff.md", "source_location": null, "rationale": "Double the wait after each failure (1, 2, 4, 8s) with a cap and a max attempt count so the server can recover instead of being hammered."}, {"id": "src_content_module_08_03_retry_backoff_jitter", "label": "Jitter", "file_type": "concept", "source_file": "src/content/module-08/03-retry-backoff.md", "source_location": null, "rationale": "Random offset on retry timing so many clients do not retry in lockstep."}, {"id": "src_content_module_08_03_retry_backoff_thundering_herd", "label": "Thundering Herd", "file_type": "concept", "source_file": "src/content/module-08/03-retry-backoff.md", "source_location": null, "rationale": "Many clients retrying simultaneously overload a recovering system again."}, {"id": "src_content_module_08_03_retry_backoff_retry_amplification", "label": "Retry Amplification", "file_type": "concept", "source_file": "src/content/module-08/03-retry-backoff.md", "source_location": null, "rationale": "With 3 retries at every layer of a call chain the load on the failing leaf multiplies (3, 9, 27 requests), worsening the outage."}, {"id": "src_content_module_08_03_retry_backoff_retry_budget", "label": "Retry Budget", "file_type": "rationale", "source_file": "src/content/module-08/03-retry-backoff.md", "source_location": null, "rationale": "Cap the fraction of traffic allowed to be retries (e.g. 10%) and retry only at the edge layer to prevent amplification."}], "edges": [{"source": "src_content_module_08_03_retry_backoff_retry", "target": "src_content_module_08_03_retry_backoff_exponential_backoff", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/03-retry-backoff.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_03_retry_backoff_retry", "target": "src_content_module_08_03_retry_backoff_jitter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/03-retry-backoff.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_03_retry_backoff_thundering_herd", "target": "src_content_module_08_03_retry_backoff_exponential_backoff", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/03-retry-backoff.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_03_retry_backoff_thundering_herd", "target": "src_content_module_08_03_retry_backoff_jitter", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/03-retry-backoff.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_03_retry_backoff_retry_amplification", "target": "src_content_module_08_03_retry_backoff_retry_budget", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/03-retry-backoff.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_03_retry_backoff_retry_amplification", "target": "src_content_module_08_03_retry_backoff_retry", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/03-retry-backoff.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_03_retry_backoff_retry", "target": "src_content_module_08_02_circuit_breaker_circuit_breaker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/03-retry-backoff.md", "source_location": null, "weight": 1.0}], "hyperedges": []}