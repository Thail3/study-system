{"nodes": [{"id": "src_content_module_28_01_system_traps_overview", "label": "System Traps Overview", "file_type": "document", "source_file": "src/content/module-28/01-system-traps-overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_28_01_system_traps_overview_system_traps", "label": "System Traps", "file_type": "concept", "source_file": "src/content/module-28/01-system-traps-overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Donella Meadows", "contributor": null, "rationale": "Structures that naturally resist every attempt at repair and recur across organizations."}, {"id": "src_content_module_28_01_system_traps_overview_policy_resistance", "label": "Policy Resistance", "file_type": "concept", "source_file": "src/content/module-28/01-system-traps-overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parties with conflicting goals each pull the system toward their own target; fix by negotiating a shared goal, not pulling harder."}, {"id": "src_content_module_28_01_system_traps_overview_drift_to_low_performance", "label": "Drift to Low Performance", "file_type": "concept", "source_file": "src/content/module-28/01-system-traps-overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Goals set from past performance slide down unnoticed; fix by anchoring to an absolute standard or letting targets only move up."}, {"id": "src_content_module_28_01_system_traps_overview_rule_beating", "label": "Rule Beating", "file_type": "concept", "source_file": "src/content/module-28/01-system-traps-overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "People follow the letter of a rule while defeating its intent (closing many trivial bugs); fix by measuring outcomes not activity."}, {"id": "src_content_module_28_01_system_traps_overview_seeking_the_wrong_goal", "label": "Seeking the Wrong Goal", "file_type": "concept", "source_file": "src/content/module-28/01-system-traps-overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The metric itself measures the wrong thing so the system optimizes perfectly in the wrong direction (call-center calls per hour); fix by checking the metric reflects the real purpose."}], "edges": [{"source": "src_content_module_28_01_system_traps_overview", "target": "src_content_module_28_01_system_traps_overview_system_traps", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-28/01-system-traps-overview.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_28_01_system_traps_overview_system_traps", "target": "src_content_module_28_01_system_traps_overview_policy_resistance", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-28/01-system-traps-overview.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_28_01_system_traps_overview_system_traps", "target": "src_content_module_28_01_system_traps_overview_drift_to_low_performance", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-28/01-system-traps-overview.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_28_01_system_traps_overview_system_traps", "target": "src_content_module_28_01_system_traps_overview_rule_beating", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-28/01-system-traps-overview.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_28_01_system_tr