{"nodes": [{"id": "src_content_module_08_09_multi_region_active_active", "label": "Multi-Region Active-Active (chapter)", "file_type": "document", "source_file": "src/content/module-08/09-multi-region-active-active.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_08_09_multi_region_active_active_active_active", "label": "Multi-Region Active-Active", "file_type": "rationale", "source_file": "src/content/module-08/09-multi-region-active-active.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All regions serve real traffic at once: survives region-level disaster and gives low latency via nearest region."}, {"id": "src_content_module_08_09_multi_region_active_active_geodns", "label": "GeoDNS", "file_type": "concept", "source_file": "src/content/module-08/09-multi-region-active-active.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_08_09_multi_region_active_active_write_conflict", "label": "Cross-Region Write Conflict", "file_type": "rationale", "source_file": "src/content/module-08/09-multi-region-active-active.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both regions accept a write locally before learning of the other, so replication must resolve conflicts."}, {"id": "src_content_module_08_09_multi_region_active_active_cap_tradeoff", "label": "CAP Trade-off (Availability over strict Consistency)", "file_type": "rationale", "source_file": "src/content/module-08/09-multi-region-active-active.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_08_09_multi_region_active_active_lww", "label": "Last-Write-Wins (LWW)", "file_type": "concept", "source_file": "src/content/module-08/09-multi-region-active-active.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Simplest conflict resolution but silently drops the losing write."}, {"id": "src_content_module_08_09_multi_region_active_active_crdt", "label": "CRDT (Conflict-free Replicated Data Type)", "file_type": "concept", "source_file": "src/content/module-08/09-multi-region-active-active.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Merges both sides automatically without discarding either; suits mergeable data such as a shopping cart."}, {"id": "src_content_module_08_09_multi_region_active_active_global_split_brain", "label": "Global Split-Brain", "file_type": "concept", "source_file": "src/content/module-08/09-multi-region-active-active.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_08_09_multi_region_active_active_quorum_cross_region", "label": "Cross-Region Quorum", "file_type": "concept", "source_file": "src/content/module-08/09-multi-region-active-active.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Majority confirmation across continents costs 100-200ms per write, so most systems accept LWW/CRDT conflicts instead."}, {"id": "src_content_module_08_09_multi_region_active_active_data_residency", "label": "Data Residency (GDPR)", "file_type": "concept", "source_file": "src/content/module-08/09-multi-region-active-active.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "src_content_module_08_09_multi_region_active_active", "target": "src_content_module_08_09_multi_region_active_active_active_active", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/co