{"nodes": [{"id": "src_content_module_04_05_consensus_leader_election_leader_election", "label": "Leader Election", "file_type": "rationale", "source_file": "src/content/module-04/05-consensus-leader-election.md", "source_location": null, "rationale": "When the Primary dies suddenly, replicas must pick a new Primary without a central coordinator; unsafe self-appointment causes split-brain, so election needs a majority rule."}, {"id": "src_content_module_04_05_consensus_leader_election_split_brain", "label": "Split-Brain", "file_type": "concept", "source_file": "src/content/module-04/05-consensus-leader-election.md", "source_location": null, "rationale": "Two or more nodes believe they are Primary and accept writes concurrently, producing conflicting data that is very hard to repair."}, {"id": "src_content_module_04_05_consensus_leader_election_majority_quorum", "label": "Majority Quorum Vote", "file_type": "rationale", "source_file": "src/content/module-04/05-consensus-leader-election.md", "source_location": null, "rationale": "A candidate needs more than half the votes; mathematically only one candidate can hold a majority in the same round, so split-brain is prevented. Odd node counts (3 or 5) are preferred because even counts add no extra fault tolerance (4 nodes need 3 votes, same as 5)."}, {"id": "src_content_module_04_05_consensus_leader_election_term", "label": "Term (Election Round Number)", "file_type": "concept", "source_file": "src/content/module-04/05-consensus-leader-election.md", "source_location": null, "rationale": "Term increments each election so a returning old Primary sees a higher term and steps down to follower instead of fighting for leadership."}, {"id": "src_content_module_04_05_consensus_leader_election_raft", "label": "Raft", "file_type": "concept", "source_file": "src/content/module-04/05-consensus-leader-election.md", "source_location": null, "rationale": "Consensus algorithm designed to be easier to understand than Paxos by separating leader election, log replication and safety; used by etcd, Consul, CockroachDB."}, {"id": "src_content_module_04_05_consensus_leader_election_paxos", "label": "Paxos", "file_type": "concept", "source_file": "src/content/module-04/05-consensus-leader-election.md", "source_location": null, "rationale": "Older theoretically correct consensus algorithm but so complex that engineers interpret it differently in practice; still used in legacy systems like Google Chubby."}, {"id": "src_content_module_04_05_consensus_leader_election_log_replication", "label": "Raft Log Replication", "file_type": "rationale", "source_file": "src/content/module-04/05-consensus-leader-election.md", "source_location": null, "rationale": "Leader writes each command to its own log, sends it to followers, and commits only after a majority confirm; a stricter form of synchronous replication."}, {"id": "src_content_module_04_05_consensus_leader_election_etcd", "label": "etcd", "file_type": "concept", "source_file": "src/content/module-04/05-consensus-leader-election.md", "source_location": null}, {"id": "src_content_module_04_05_consensus_leader_election_consul", "label": "Consul", "file_type": "concept", "source_file": "src/content/module-04/05-consensus-leader-election.md", "source_location": null}], "edges": [{"source": "src_content_module_04_05_consensus_leader_election_split_brain", "target": "src_content_module_04_05_consensus_leader_election_majority_quorum", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-04/05-consensus-leader-election.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_04_05_consensus_leader_election_leader_election", "target": "src_content_module_04_05_consensus_leader_election_majority_quorum", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-04/05-consensus-leader-election.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_04_05_consensus_leader_election_leader_election", "target": "src_content_module_04_05_consensus_leader_election_split_brain", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-04/05-consensus-leader-election.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_04_05_consensus_leader_election_term", "target": "src_content_module_04_05_consensus_leader_election_leader_election", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-04/05-consensus-leader-election.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_04_05_consensus_leader_election_raft", "target": "src_content_module_04_05_consensus_leader_election_leader_election", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-04/05-consensus-leader-election.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_04_05_consensus_leader_election_raft", "target": "src_content_module_04_05_consensus_leader_election_term", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-04/05-consensus-leader-election.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_04_05_consensus_leader_election_raft", "target": "src_content_module_04_05_consensus_leader_election_paxos", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-04/05-consensus-leader-election.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_04_05_consensus_leader_election_log_replication", "target": "src_content_module_04_05_consensus_leader_election_raft", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-04/05-consensus-leader-election.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_04_05_consensus_leader_election_raft", "target": "src_content_module_04_05_consensus_leader_election_etcd", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-04/05-consensus-leader-election.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_04_05_consensus_leader_election_raft", "target": "src_content_module_04_05_consensus_leader_election_consul", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-04/05-consensus-leader-election.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_04_05_consensus_leader_election_leader_election", "target": "src_content_module_05_01_cap_theorem_cap_theorem", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-04/05-consensus-leader-election.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_04_05_consensus_leader_election_leader_election", "target": "src_content_module_08_04_failover_redundancy_failover", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-04/05-consensus-leader-election.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_04_05_consensus_leader_election_log_replication", "target": "src_content_module_04_05_consensus_leader_election_majority_quorum", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-04/05-consensus-leader-election.md", "source_location": null, "weight": 1.0}], "hyperedges": []}