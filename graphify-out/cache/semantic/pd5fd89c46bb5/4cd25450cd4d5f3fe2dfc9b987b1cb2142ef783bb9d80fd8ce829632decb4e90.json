{"nodes": [{"id": "src_content_module_51_03_progressive_delivery", "label": "Progressive Delivery (lesson)", "file_type": "document", "source_file": "src/content/module-51/03-progressive-delivery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_51_03_progressive_delivery_progressive_delivery", "label": "Progressive Delivery", "file_type": "rationale", "source_file": "src/content/module-51/03-progressive-delivery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Canary where the system, not a human, watches real metrics and decides to expand traffic or auto-rollback."}, {"id": "src_content_module_51_03_progressive_delivery_deploy_vs_release", "label": "Deploy vs Release", "file_type": "rationale", "source_file": "src/content/module-51/03-progressive-delivery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Getting code onto production (deploy) is separable from exposing it to users (release); feature flags let teams deploy silently and release gradually without redeploying."}, {"id": "src_content_module_51_03_progressive_delivery_feature_flag", "label": "Feature Flag", "file_type": "concept", "source_file": "src/content/module-51/03-progressive-delivery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_51_03_progressive_delivery_canary_release", "label": "Canary Release", "file_type": "concept", "source_file": "src/content/module-51/03-progressive-delivery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_51_03_progressive_delivery_blue_green_deployment", "label": "Blue-Green Deployment", "file_type": "concept", "source_file": "src/content/module-51/03-progressive-delivery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_51_03_progressive_delivery_auto_rollback", "label": "Auto-Rollback", "file_type": "concept", "source_file": "src/content/module-51/03-progressive-delivery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_51_03_progressive_delivery_slo_based_metric_gate", "label": "SLO-aligned Canary Metric Gate", "file_type": "rationale", "source_file": "src/content/module-51/03-progressive-delivery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gate metrics must match SLO metrics (error rate, p99 latency via RED) rather than deploy success, so real user impact triggers rollback without human attention."}, {"id": "src_content_module_51_03_progressive_delivery_canary_representativeness_problem", "label": "Canary Cohort Not Representative", "file_type": "rationale", "source_file": "src/content/module-51/03-progressive-delivery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The first 5% of users may not represent all users (e.g. only new browsers); sample across region and device type instead of simple first-come requests."}, {"id": "src_content_module_51_03_progressive_delivery_defense_in_depth_release", "label": "Layered Release Safety (pipeline + canary + feature flag)", "file_type": "rationale", "source_file": "src/content/module-51/03-progressive-delivery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blue-green, canary and feature flags are used together, not exclusively: single artifact via pipeline, canary traffic rollout, then business-logic visibility via flags."}], "edges": [{"source": "src_content_module_51_03_progressive_delivery"