{"nodes": [{"id": "src_content_module_28_04_shifting_burden_to_intervenor", "label": "Shifting the Burden to the Intervenor", "file_type": "document", "source_file": "src/content/module-28/04-shifting-burden-to-intervenor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_28_04_shifting_burden_to_intervenor_shifting_the_burden", "label": "Shifting the Burden", "file_type": "concept", "source_file": "src/content/module-28/04-shifting-burden-to-intervenor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A quick fix erodes the system's own ability to build a permanent fix."}, {"id": "src_content_module_28_04_shifting_burden_to_intervenor_shifting_burden_to_intervenor", "label": "Shifting the Burden to the Intervenor (Addiction)", "file_type": "concept", "source_file": "src/content/module-28/04-shifting-burden-to-intervenor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Quick fix comes from an outside intervenor, eroding total self-reliance; a third R loop forms because the intervenor's revenue depends on continued dependence."}, {"id": "src_content_module_28_04_shifting_burden_to_intervenor_consultant_dependency_example", "label": "Consultant Dependency Example", "file_type": "concept", "source_file": "src/content/module-28/04-shifting-burden-to-intervenor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "External consultants fix infra faster each time so the in-house team never practices; dependence and cost grow."}, {"id": "src_content_module_28_04_shifting_burden_to_intervenor_exit_conditions", "label": "Exit Conditions and Knowledge Transfer for Intervenors", "file_type": "concept", "source_file": "src/content/module-28/04-shifting-burden-to-intervenor.md", "source_