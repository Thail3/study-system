{"nodes": [{"id": "src_content_module_28_02_boundary_problem", "label": "The Boundary Problem", "file_type": "document", "source_file": "src/content/module-28/02-boundary-problem.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_28_02_boundary_problem_system_boundary", "label": "System Boundary", "file_type": "concept", "source_file": "src/content/module-28/02-boundary-problem.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Boundaries are chosen, not given; wider boundaries reveal higher-leverage fixes but exceed one team's authority, while too wide is unanalyzable. Ask whether the boundary is wide enough to see the key feedback loop."}, {"id": "src_content_module_28_02_boundary_problem_slow_service_boundary_example", "label": "Slow Service Example (narrow / medium / wide boundary)", "file_type": "concept", "source_file": "src/content/module-28/02-boundary-problem.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same latency problem yields code optimization at narrow scope, circuit breakers at medium scope, and company headcount policy at wide scope."}, {"id": "src_content_module_28_02_boundary_problem_narrow_boundary_root_of_traps", "label": "Narrow Boundary as Root of Many System Traps", "file_type": "rationale", "source_file": "src/content/module-28/02-boundary-problem.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tragedy of the Commons arises when each party sees only its own boundary; Shifting the Burden arises when long-term capability is left outside the decision boundary."}], "edges": [{"source": "src_content_module_28_02_boundary_problem", "target": "src_content_module_28_02_boundary_problem_system_boundary", "relation": "references", "confidence": "EXTR