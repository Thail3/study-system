{"nodes": [{"id": "src_content_module_06_01_why_async_synchronous_request", "label": "Synchronous Request", "file_type": "concept", "source_file": "src/content/module-06/01-why-async.md", "source_location": null, "rationale": "Client waits until the server finishes; heavy jobs (video encode) risk client timeout and tie up the server."}, {"id": "src_content_module_06_01_why_async_async_job_pattern", "label": "Accept-Then-Process-Later (Async Job) Pattern", "file_type": "rationale", "source_file": "src/content/module-06/01-why-async.md", "source_location": null, "rationale": "Separate receiving the request from doing the work: respond immediately with a job_id, enqueue the work, let a worker process it, and notify later. Like a laundry shop receipt."}, {"id": "src_content_module_06_01_why_async_webhook", "label": "Webhook", "file_type": "concept", "source_file": "src/content/module-06/01-why-async.md", "source_location": null, "rationale": "Server calls the client's endpoint to deliver the result; can fail if the client is down, so it needs retries, dead letter and a polling fallback."}, {"id": "src_content_module_06_01_why_async_dead_letter", "label": "Dead Letter", "file_type": "concept", "source_file": "src/content/module-06/01-why-async.md", "source_location": null, "rationale": "Holding place for work that failed after all retries so the team can inspect it instead of losing it silently."}, {"id": "src_content_module_06_01_why_async_signature_verification", "label": "Webhook Signature Verification", "file_type": "concept", "source_file": "src/content/module-06/01-why-async.md", "source_location": null, "rationale": "Signed payload lets the receiver prove a webhook really came from the real server."}, {"id": "src_content_module_06_01_why_async_client_polling", "label": "Client Polling Fallback", "file_type": "concept", "source_file": "src/content/module-06/01-why-async.md", "source_location": null, "rationale": "Client can query job status itself so results are not lost if a webhook delivery fails."}], "edges": [{"source": "src_content_module_06_01_why_async_synchronous_request", "target": "src_content_module_06_01_why_async_async_job_pattern", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-06/01-why-async.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_06_01_why_async_async_job_pattern", "target": "src_content_module_06_02_message_queue_message_queue", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-06/01-why-async.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_06_01_why_async_async_job_pattern", "target": "src_content_module_06_03_pub_sub_pub_sub", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-06/01-why-async.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_06_01_why_async_async_job_pattern", "target": "src_content_module_06_04_event_driven_event_driven_architecture", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-06/01-why-async.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_06_01_why_async_webhook", "target": "src_content_module_06_01_why_async_async_job_pattern", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-06/01-why-async.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_06_01_why_async_webhook", "target": "src_content_module_08_03_retry_backoff_exponential_backoff", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-06/01-why-async.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_06_01_why_async_webhook", "target": "src_content_module_06_01_why_async_dead_letter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-06/01-why-async.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_06_01_why_async_webhook", "target": "src_content_module_06_01_why_async_signature_verification", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-06/01-why-async.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_06_01_why_async_client_polling", "target": "src_content_module_06_01_why_async_webhook", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-06/01-why-async.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "module_06_async_messaging_family", "label": "Async Messaging Approaches (Async Job, Queue, Pub/Sub, Event-Driven)", "nodes": ["src_content_module_06_01_why_async_async_job_pattern", "src_content_module_06_02_message_queue_message_queue", "src_content_module_06_03_pub_sub_pub_sub", "src_content_module_06_04_event_driven_event_driven_architecture"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-06/01-why-async.md"}]}