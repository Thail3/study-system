{"nodes": [{"id": "src_content_module_29_02_conways_law_systems_view", "label": "Case: Conway's Law through a Systems Lens", "file_type": "document", "source_file": "src/content/module-29/02-conways-law-systems-view.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_29_02_conways_law_systems_view_conways_law", "label": "Conway's Law", "file_type": "concept", "source_file": "src/content/module-29/02-conways-law-systems-view.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Melvin Conway", "contributor": null, "rationale": "Organizations produce systems that copy their communication structure (1967)."}, {"id": "src_content_module_29_02_conways_law_systems_view_org_software_lock_in_loop", "label": "Org-Software Reinforcing Lock-in Loop", "file_type": "concept", "source_file": "src/content/module-29/02-conways-law-systems-view.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Org shapes software and software shapes org because crossing module boundaries is costly, locking structure tighter over time."}, {"id": "src_content_module_29_02_conways_law_systems_view_inverse_conway_maneuver", "label": "Inverse Conway Maneuver", "file_type": "concept", "source_file": "src/content/module-29/02-conways-law-systems-view.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reorganize teams to match the target architecture first, then let the same R loop lock in the new design instead of fighting it."}, {"id": "src_content_module_29_02_conways_law_systems_view_fixes_that_fail", "label": "Fixes That Fail", "file_type": "concept", "source_file": "src/content/module-29/02-conways-law-systems-view.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fix treats the symptom while the underlying driver persists, so the system drifts back."}, {"id": "src_content_module_29_02_conways_law_systems_view_top_down_architecture_announcement", "label": "Top-Down Architecture Announcement (failed fix)", "file_type": "concept", "source_file": "src/content/module-29/02-conways-law-systems-view.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Declaring microservices without changing team structure is parameter-level; the R loop pulls code back and the new architecture becomes renamed folders."}], "edges": [{"source": "src_content_module_29_02_conways_law_systems_view", "target": "src_content_module_29_02_conways_law_systems_view_conways_law", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-29/02-conways-law-systems-view.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_29_02_conways_law_systems_view", "target": "src_content_module_28_03_mental_models_and_systems_iceberg_model", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "src/content/module-29/02-conways-law-systems-view.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_29_02_conways_law_systems_view_conways_law", "target": "src_content_module_29_02_conways_law_systems_view_org_software_lock_in_loop", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-29/02-conways-law-systems-view.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_29_02_conways_law_systems_view_inverse_conway_maneuver", "target": "src_content_module_29_02_conways_law_systems_view_conways_law", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-29/02-conways-law-systems-view.md", "source_location": null, "weight": 1.0}, {"sourc