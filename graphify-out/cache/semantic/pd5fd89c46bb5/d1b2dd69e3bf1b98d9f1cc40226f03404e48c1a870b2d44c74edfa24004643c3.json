{"nodes": [{"id": "src_content_module_08_04_failover_redundancy_redundancy", "label": "Redundancy", "file_type": "rationale", "source_file": "src/content/module-08/04-failover-redundancy.md", "source_location": null, "rationale": "No component should exist as a single copy: load balancers, database primaries, gateways and servers all need spares."}, {"id": "src_content_module_08_04_failover_redundancy_failover", "label": "Failover", "file_type": "concept", "source_file": "src/content/module-08/04-failover-redundancy.md", "source_location": null, "rationale": "A health checker detects a dead primary and switches traffic to a standby via DNS or load balancer; a standby never tested may be broken when needed."}, {"id": "src_content_module_08_04_failover_redundancy_active_passive", "label": "Active-Passive", "file_type": "concept", "source_file": "src/content/module-08/04-failover-redundancy.md", "source_location": null, "rationale": "Standby idles until the primary fails; simple but wastes standby resources."}, {"id": "src_content_module_08_04_failover_redundancy_active_active", "label": "Active-Active", "file_type": "concept", "source_file": "src/content/module-08/04-failover-redundancy.md", "source_location": null, "rationale": "All replicas serve traffic at once; efficient and no switchover, but requires stateless design and handling concurrent writes."}, {"id": "src_content_module_08_04_failover_redundancy_multi_region", "label": "Multi-Region Redundancy", "file_type": "concept", "source_file": "src/content/module-08/04-failover-redundancy.md", "source_location": null, "rationale": "Backup data center in another geography with cross-region replication; highest cost and complexity, used when downtime is extremely costly."}, {"id": "src_content_module_08_04_failover_redundancy_chaos_engineering", "label": "Chaos Engineering", "file_type": "rationale", "source_file": "src/content/module-08/04-failover-redundancy.md", "source_location": null, "rationale": "Deliberately inject failures in a controlled setting (e.g. Chaos Monkey) to prove failover works before a real outage picks its own worst time."}, {"id": "src_content_module_08_04_failover_redundancy_health_checker", "label": "Health Checker", "file_type": "concept", "source_file": "src/content/module-08/04-failover-redundancy.md", "source_location": null}, {"id": "src_content_module_08_04_failover_redundancy_availability_nines", "label": "Availability Nines (99.9%, 99.99%)", "file_type": "concept", "source_file": "src/content/module-08/04-failover-redundancy.md", "source_location": null, "rationale": "No system has zero downtime; 99.9% is about 8.7 hours per year and 99.99% about 52 minutes."}], "edges": [{"source": "src_content_module_08_04_failover_redundancy_redundancy", "target": "src_content_module_08_04_failover_redundancy_failover", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/04-failover-redundancy.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_04_failover_redundancy_failover", "target": "src_content_module_08_04_failover_redundancy_active_passive", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/04-failover-redundancy.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_04_failover_redundancy_failover", "target": "src_content_module_08_04_failover_redundancy_active_active", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/04-failover-redundancy.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_04_failover_redundancy_failover", "target": "src_content_module_08_04_failover_redundancy_health_checker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/04-failover-redundancy.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_04_failover_redundancy_active_passive", "target": "src_content_module_08_04_failover_redundancy_active_active", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/04-failover-redundancy.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_04_failover_redundancy_multi_region", "target": "src_content_module_08_04_failover_redundancy_redundancy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/04-failover-redundancy.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_04_failover_redundancy_chaos_engineering", "target": "src_content_module_08_04_failover_redundancy_failover", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/04-failover-redundancy.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_04_failover_redundancy_active_active", "target": "src_content_module_05_01_cap_theorem_cap_theorem", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/04-failover-redundancy.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_04_failover_redundancy_redundancy", "target": "src_content_module_08_04_failover_redundancy_availability_nines", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "src/content/module-08/04-failover-redundancy.md", "source_location": null, "weight": 1.0}], "hyperedges": []}