{"nodes": [{"id": "src_content_module_07_01_monolith_vs_microservices_monolith", "label": "Monolith", "file_type": "concept", "source_file": "src/content/module-07/01-monolith-vs-microservices.md", "source_location": null, "rationale": "Single codebase and deployment with in-process calls; easy to start, debug and test but scales only as a whole. Most teams should start here."}, {"id": "src_content_module_07_01_monolith_vs_microservices_microservices", "label": "Microservices", "file_type": "concept", "source_file": "src/content/module-07/01-monolith-vs-microservices.md", "source_location": null, "rationale": "Independent services with separate deploy and scaling, communicating over the network; split only when pain appears (slow deploys, coupled changes, uneven scaling, team boundaries)."}, {"id": "src_content_module_07_01_monolith_vs_microservices_modular_monolith", "label": "Modular Monolith", "file_type": "rationale", "source_file": "src/content/module-07/01-monolith-vs-microservices.md", "source_location": null, "rationale": "One deployable with clear internal module boundaries, making a later split into services much easier."}, {"id": "src_content_module_07_01_monolith_vs_microservices_distributed_monolith", "label": "Distributed Monolith", "file_type": "concept", "source_file": "src/content/module-07/01-monolith-vs-microservices.md", "source_location": null, "rationale": "Services split by shape but still tightly coupled (shared database, coordinated deploys), paying microservice costs without benefits; worse than the original monolith."}, {"id": "src_content_module_07_01_monolith_vs_microservices_microservices_costs", "label": "Hidden Costs of Microservices", "file_type": "concept", "source_file": "src/content/module-07/01-monolith-vs-microservices.md", "source_location": null, "rationale": "Network latency, partial failure, distributed transactions and operational overhead that were free inside a monolith."}], "edges": [{"source": "src_content_module_07_01_monolith_vs_microservices_microservices", "target": "src_content_module_07_01_monolith_vs_microservices_monolith", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-07/01-monolith-vs-microservices.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_07_01_monolith_vs_microservices_modular_monolith", "target": "src_content_module_07_01_monolith_vs_microservices_monolith", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-07/01-monolith-vs-microservices.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_07_01_monolith_vs_microservices_modular_monolith", "target": "src_content_module_07_01_monolith_vs_microservices_microservices", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-07/01-monolith-vs-microservices.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_07_01_monolith_vs_microservices_distributed_monolith", "target": "src_content_module_07_01_monolith_vs_microservices_microservices", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-07/01-monolith-vs-microservices.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_07_01_monolith_vs_microservices_microservices_costs", "target": "src_content_module_07_01_monolith_vs_microservices_microservices", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-07/01-monolith-vs-microservices.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_07_01_monolith_vs_microservices_microservices_costs", "target": "src_content_module_07_05_distributed_transactions_saga_saga", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "src/conten