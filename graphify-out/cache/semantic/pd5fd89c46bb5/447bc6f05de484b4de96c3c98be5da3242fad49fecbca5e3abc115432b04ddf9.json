{"nodes": [{"id": "src_content_module_27_03_leverage_points_in_practice", "label": "Leverage Points in Practice (On-call Fatigue Case)", "file_type": "document", "source_file": "src/content/module-27/03-leverage-points-in-practice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_27_03_leverage_points_in_practice_error_budget", "label": "Error Budget (SRE)", "file_type": "concept", "source_file": "src/content/module-27/03-leverage-points-in-practice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If reliability falls below target, pause new features to fix reliability; adding it to team goals aligned every decision automatically."}, {"id": "src_content_module_27_03_leverage_points_in_practice_alert_threshold_fix", "label": "Alert Threshold Tuning (failed parameter fix)", "file_type": "concept", "source_file": "src/content/module-27/03-leverage-points-in-practice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raising thresholds filtered out important alerts and left the real problem (too few people for the workload) untouched."}, {"id": "src_content_module_27_03_leverage_points_in_practice_oncall_visibility_rule", "label": "On-call Dashboard + Recurring-Incident Rule (partial structure fix)", "file_type": "concept", "source_file": "src/content/module-27/03-leverage-points-in-practice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Showing on-call load to executives and forcing sprint capacity for incidents recurring over 3 times/month reduced incidents but on-call stayed heavier than other teams."}, {"id": "src_content_module_27_03_leverage_points_in_practice_goal_change_lesson", "label": "Changing How Performance Is Measured as Strongest Leverage", "file_type": "