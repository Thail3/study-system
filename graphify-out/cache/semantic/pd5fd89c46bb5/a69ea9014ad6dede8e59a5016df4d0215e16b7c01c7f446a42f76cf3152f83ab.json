{"nodes": [{"id": "src_content_module_08_05_observability_observability", "label": "Observability", "file_type": "concept", "source_file": "src/content/module-08/05-observability.md", "source_location": null, "rationale": "Answers how to know the system is failing and where; built on logs, metrics and traces used together."}, {"id": "src_content_module_08_05_observability_log", "label": "Structured Log", "file_type": "concept", "source_file": "src/content/module-08/05-observability.md", "source_location": null, "rationale": "Detailed searchable event records with fields like req_id; too voluminous to store for every request at high traffic."}, {"id": "src_content_module_08_05_observability_metric", "label": "Metric", "file_type": "concept", "source_file": "src/content/module-08/05-observability.md", "source_location": null, "rationale": "Cheap aggregated numbers over time (error rate, latency) tied to alert thresholds."}, {"id": "src_content_module_08_05_observability_trace", "label": "Distributed Trace", "file_type": "concept", "source_file": "src/content/module-08/05-observability.md", "source_location": null, "rationale": "A trace ID follows one request across services and renders as a waterfall of spans to find the slow hop."}, {"id": "src_content_module_08_05_observability_alerting", "label": "Alerting", "file_type": "concept", "source_file": "src/content/module-08/05-observability.md", "source_location": null}, {"id": "src_content_module_08_05_observability_cardinality_explosion", "label": "Cardinality Explosion", "file_type": "concept", "source_file": "src/content/module-08/05-observability.md", "source_location": null, "rationale": "Tagging metrics with high-variety values like user_id creates millions of time series and can crash the monitoring system; use bounded tags and put per-user detail in logs or traces."}, {"id": "src_content_module_08_05_observability_investigation_flow", "label": "Metric then Trace then Log Investigation Flow", "file_type": "ratio