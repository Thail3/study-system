{"nodes": [{"id": "src_content_module_30_05_supply_chain_security_advanced_supply_chain_security", "label": "Supply Chain Security", "file_type": "rationale", "source_file": "src/content/module-30/05-supply-chain-security-advanced.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Risk extends beyond own code to dependencies, base images and build pipeline tools; one compromised library infects every dependent app even with bug-free own code."}, {"id": "src_content_module_30_05_supply_chain_security_advanced_sbom", "label": "SBOM (Software Bill of Materials)", "file_type": "concept", "source_file": "src/content/module-30/05-supply-chain-security-advanced.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Manifest of every dependency and exact version per build (Syft, CycloneDX); turns 'are we affected?' from manual audit into a database query."}, {"id": "src_content_module_30_05_supply_chain_security_advanced_dependency_signing_provenance", "label": "Dependency Signing / Provenance", "file_type": "concept", "source_file": "src/content/module-30/05-supply-chain-security-advanced.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trust verifiable signatures rather than matching name/version; provenance records which source and build system produced the artifact. Protects against unknown threats that scanners cannot detect."}, {"id": "src_content_module_30_05_supply_chain_security_advanced_slsa", "label": "SLSA (Supply-chain Levels for Software Artifacts)", "file_type": "concept", "source_file": "src/content/module-30/05-supply-chain-security-advanced.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_30_05_supply_chain_security_advanced_cve", "label": "CVE (Common Vulnerabilities and Exposures)", "file_type": "concept", "source_file": "src/content/module-30/05-supply-chain-security-advanced.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_30_05_supply_chain_security_advanced_typosquatting", "label": "Typosquatting", "file_type": "concept", "source_file": "src/content/module-30/05-supply-chain-security-advanced.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_30_05_supply_chain_security_advanced_adr_sbom_and_signature_verification_in_ci", "label": "ADR: SBOM generation and dependency signature verification in CI", "file_type": "rationale", "source_file": "src/content/module-30/05-supply-chain-security-advanced.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A critical CVE took 2 days of manual audit to scope; CI now emits an SBOM per build and verifies signatures, cutting audit to minutes at the cost of slightly longer builds and some unsigned dependencies needing replacement."}], "edges": [{"source": "src_content_module_30_05_supply_chain_security_advanced_supply_chain_security", "target": "src_content_module_30_05_supply_chain_security_advanced_sbom", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-30/05-supply-chain-security-advanced.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_30_05_supply_chain_security_advanced_supply_chain_security", "target": "src_content_module_30_05_supply_chain_security_advanced_dependency_signing_provenance", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-30/05-supply-chain-security-advanced.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_30_05_supply_