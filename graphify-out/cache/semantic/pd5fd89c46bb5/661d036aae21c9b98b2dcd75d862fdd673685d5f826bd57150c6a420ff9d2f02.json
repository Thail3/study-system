{"nodes": [{"id": "src_content_module_49_01_layered_architecture", "label": "Layered Architecture (lesson)", "file_type": "document", "source_file": "src/content/module-49/01-layered-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_49_01_layered_architecture_layered_architecture", "label": "Layered Architecture", "file_type": "rationale", "source_file": "src/content/module-49/01-layered-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Splits code into Presentation, Business and Data Access layers, each calling only downward; looks tidy but does not enforce dependency direction, so business logic can still bind to concrete infrastructure."}, {"id": "src_content_module_49_01_layered_architecture_presentation_layer", "label": "Presentation Layer", "file_type": "concept", "source_file": "src/content/module-49/01-layered-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_49_01_layered_architecture_business_layer", "label": "Business Layer", "file_type": "concept", "source_file": "src/content/module-49/01-layered-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_49_01_layered_architecture_data_access_layer", "label": "Data Access Layer", "file_type": "concept", "source_file": "src/content/module-49/01-layered-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_49_01_layered_architecture_userservice", "label": "UserService", "file_type": "code", "source_file": "src/content/module-49/01-layered-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contribut