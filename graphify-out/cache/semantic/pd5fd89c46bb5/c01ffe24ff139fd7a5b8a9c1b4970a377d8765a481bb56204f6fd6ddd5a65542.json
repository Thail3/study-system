{"nodes": [{"id": "src_content_module_15_05_domain_events_acl_advanced_doc", "label": "Domain Events & ACL Advanced (note)", "file_type": "document", "source_file": "src/content/module-15/05-domain-events-acl-advanced.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_15_05_domain_events_acl_advanced_domain_event", "label": "Domain Event", "file_type": "concept", "source_file": "src/content/module-15/05-domain-events-acl-advanced.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Past-tense statement of something that happened, in the publisher's own language; publisher does not know subscribers, enabling async decoupling."}, {"id": "src_content_module_15_05_domain_events_acl_advanced_anti_corruption_layer", "label": "Anti-Corruption Layer (mechanism)", "file_type": "concept", "source_file": "src/content/module-15/05-domain-events-acl-advanced.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A set of facade, adapter and translator that solves both technical and conceptual mismatch, e.g. splitting an overloaded legacy status field into PaymentStatus and ApprovalStatus value objects."}, {"id": "src_content_module_15_05_domain_events_acl_advanced_event_contract_design", "label": "Event Contract Separate From Internal Schema", "file_type": "rationale", "source_file": "src/content/module-15/05-domain-events-acl-advanced.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dumping table columns or internal objects into event payloads ties every consumer to the publisher's schema; treat the event as a backward-compatible public API."}, {"id": "src_content_module_15_05_domain_events_acl_advanced_acl_components", "label": "ACL Facade, Adapter, Translator", "file_type": "concept", "source_file": "src/content/module-15/05-domain-events-acl-advanced.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_15_05_domain_events_acl_advanced_acl_domain_event_bridge", "label": "ACL That Emits Domain Events", "file_type": "concept", "source_file": "src/content/module-15/05-domain-events-acl-advanced.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ACL polls or subscribes to external signals (e.g. legacy change-log) and emits clean domain events such as InvoiceSettled so internal consumers never see legacy shape."}, {"id": "src_content_module_15_05_domain_events_acl_advanced_control_criterion", "label": "Choose by Whether We Control the Other Side", "file_type": "rationale", "source_file": "src/content/module-15/05-domain-events-acl-advanced.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not sync vs async: use Domain Events where we control or can negotiate the contract, ACL where we cannot change the other model."}, {"id": "src_content_module_15_05_domain_events_acl_advanced_unnecessary_acl", "label": "Full ACL Between Own Contexts (anti-pattern)", "file_type": "rationale", "source_file": "src/content/module-15/05-domain-events-acl-advanced.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ACL costs more to maintain than an agreed event contract; unnecessary complexity when both sides are talkable."}, {"id": "src_content_module_15_05_domain_events_acl_advanced_vendor_api_case", "label": "Interview: Unstable Vendor API Format", "file_type": "concept", "source_file": "src/content/module-15/05-domain-events-acl-advanced.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Try-catch at call sites fixes only one place; senior answer is a single ACL that knows all vendor quirks."}, {"id": "src_content_module_15_05_domain_events_acl_advanced_adr_events_and_acl", "label": "ADR: Domain Events Internally, ACL at Legacy Edge", "file_type": "concept", "source_file": "src/content/module-15/05-domain-events-acl-advanced.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accepted: add consumers without touching code, core domain insulated from legacy; cost is maintaining ACL code."}], "edges": [{"source": "src_content_module_15_05_domain_events_acl_advanced_doc", "target": "src_content_module_15_05_domain_events_acl_advanced_domain_event", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-15/05-domain-events-acl-advanced.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_15_05_domain_events_acl_advanced_doc", "target": "src_content_module_15_05_domain_events_acl_advanced_anti_corruption_layer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-15/05-domain-events-acl-advanced.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_15_05_domain_events_acl_advanced_domain_event", "target": "src_content_module_15_05_domain_events_acl_advanced_event_contract_design", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-15/05-domain-events-acl-advanced.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_15_05_domain_events_acl_advanced_event_contract_design", "target": "src_content_module_15_05_domain_events_acl_advanced_domain_event", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-15/05-domain-events-acl-advanced.md", "source_location": null, "weight": 1.0}, {"source": "src_conten