{"nodes": [{"id": "src_content_module_35_03_sli_slo_dashboard", "label": "SLI/SLO Dashboard", "file_type": "document", "source_file": "src/content/module-35/03-sli-slo-dashboard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_35_03_sli_slo_dashboard_sli", "label": "SLI (Service Level Indicator)", "file_type": "concept", "source_file": "src/content/module-35/03-sli-slo-dashboard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measured value tied directly to user experience, e.g. % of requests answered successfully within 500ms; derived from Golden Signals metrics but over a rolling window."}, {"id": "src_content_module_35_03_sli_slo_dashboard_slo", "label": "SLO (Service Level Objective)", "file_type": "concept", "source_file": "src/content/module-35/03-sli-slo-dashboard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Target set for an SLI, e.g. SLI >= 99.9% over rolling 30 days."}, {"id": "src_content_module_35_03_sli_slo_dashboard_error_budget", "label": "Error Budget", "file_type": "concept", "source_file": "src/content/module-35/03-sli-slo-dashboard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Acceptable failure quota = 100% - SLO target (99.9% SLO means 0.1% budget)."}, {"id": "src_content_module_35_03_sli_slo_dashboard_sli_slo_dashboard", "label": "SLI/SLO Dashboard Layout", "file_type": "concept", "source_file": "src/content/module-35/03-sli-slo-dashboard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Executives should see SLI vs SLO because raw error rate has no context for 'how bad is bad'; panels: current SLI vs target, 30-day trend with target line, error budget remaining."}, {"id": "src_content_module_35_03_sli_slo_dashboard_unrealistic_slo_trap", "label": "Unrealistic SLO Trap", "file_type": "rationale", "source_file": "src/content/module-35/03-sli-slo-dashboard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SLO set higher than the system ever achieved (e.g. 99.99%) makes the budget permanently exhausted and the dashboard permanently red, so the team ignores it; base SLOs on historical data and business tolerance."}], "edges": [{"source": "src_content_module_35_03_sli_slo_dashboard", "target": "src_content_module_35_03_sli_slo_dashboard_sli_slo_dashboard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-35/03-sli-slo-dashboard.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_35_03_sli_slo_dashboard_slo", "target": "src_content_module_35_03_sli_slo_dashboard_sli", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-35/03-sli-slo-dashboard.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_35_03_sli_slo_dashboard_error_budget", "target": "src_content_module_35_03_sli_slo_dashboard_slo", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-35/03-sli-slo-dashboard.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_35_03_sli_slo_dashboard_sli_slo_dashboard", "target": "src_content_module_35_03_sli_slo_dashboard_sli", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-35/03-sli-slo-dashboard.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_35_03_sli_slo_dashboard_sli_slo_dashboard", "target": "src_content_module_35_03_sli_slo_dashboard_slo", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0,