{"nodes": [{"id": "src_content_module_27_01_twelve_leverage_points", "label": "Twelve Leverage Points", "file_type": "document", "source_file": "src/content/module-27/01-twelve-leverage-points.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_27_01_twelve_leverage_points_leverage_point", "label": "Leverage Point", "file_type": "concept", "source_file": "src/content/module-27/01-twelve-leverage-points.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A point in a system where a small change produces a large change in overall behavior; higher leverage means harder and more resisted change."}, {"id": "src_content_module_27_01_twelve_leverage_points_meadows_twelve_levels", "label": "Meadows' 12 Leverage Point Levels", "file_type": "concept", "source_file": "src/content/module-27/01-twelve-leverage-points.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Donella Meadows", "contributor": null}, {"id": "src_content_module_27_01_twelve_leverage_points_parameters", "label": "Parameters/Constants (Level 12)", "file_type": "concept", "source_file": "src/content/module-27/01-twelve-leverage-points.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weakest leverage point (timeout, retry count); most commonly chosen because it is easy, fast and needs no approval."}, {"id": "src_content_module_27_01_twelve_leverage_points_information_flows", "label": "Information Flows (Level 6)", "file_type": "concept", "source_file": "src/content/module-27/01-twelve-leverage-points.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Who sees what data and when; real-time deploy dashboard speeds team response."}, {"id": "src_content_module_27_01_twelve_leverage_points_rules", "label": "Rules (Level 5)", "file_type": "concept", "source_file": "src/content/module-27/01-twelve-leverage-points.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rules, incentives, constraints change whole-team behavior immediately without relying on individual discipline (e.g. CI must be green before merge)."}, {"id": "src_content_module_27_01_twelve_leverage_points_goals", "label": "Goals (Level 3)", "file_type": "concept", "source_file": "src/content/module-27/01-twelve-leverage-points.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Changing the system goal realigns every decision automatically."}, {"id": "src_content_module_27_01_twelve_leverage_points_paradigm", "label": "Paradigm (Level 2)", "file_type": "concept", "source_file": "src/content/module-27/01-twelve-leverage-points.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The mindset the system rests on (deploy is a risk vs deploy is routine); changing it changes team culture, not just one rule."}, {"id": "src_content_module_27_01_twelve_leverage_points_parameter_tweaking_trap", "label": "Parameter-Tweaking Trap", "file_type": "rationale", "source_file": "src/content/module-27/01-twelve-leverage-points.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Organizations keep tuning parameters because it is easiest and needs no approval, even though it has least leverage; higher levels need senior authority and meet resistance."}], "edges": [{"source": "src_content_module_27_01_twelve_leverage_points", "target": "src_content_module_27_01_twelve_leverage_points_leverage_point", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-27/01-twelve-leverage-points.m