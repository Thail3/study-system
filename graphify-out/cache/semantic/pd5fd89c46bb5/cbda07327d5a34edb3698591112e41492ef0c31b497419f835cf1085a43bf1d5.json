{"nodes": [{"id": "src_content_module_16_04_tradeoff_case_doc", "label": "Trade-off Case: Cross-region Chat (note)", "file_type": "document", "source_file": "src/content/module-16/04-tradeoff-case.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_16_04_tradeoff_case_consistency_vs_latency", "label": "Consistency vs Latency Trade-off", "file_type": "concept", "source_file": "src/content/module-16/04-tradeoff-case.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Strong consistency across distant regions needs round-trip confirmation (150-200ms), which cannot be beaten by physics; low latency means showing results before confirmation."}, {"id": "src_content_module_16_04_tradeoff_case_pacelc", "label": "PACELC", "file_type": "concept", "source_file": "src/content/module-16/04-tradeoff-case.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Even with no partition, the system must pick latency or consistency ('Else' part); CAP covers only partitions."}, {"id": "src_content_module_16_04_tradeoff_case_synchronous_replication", "label": "Synchronous Replication", "file_type": "concept", "source_file": "src/content/module-16/04-tradeoff-case.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_16_04_tradeoff_case_eventual_consistency", "label": "Eventual Consistency", "file_type": "concept", "source_file": "src/content/module-16/04-tradeoff-case.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_16_04_tradeoff_case_local_sequencer", "label": "Local Sequencer", "file_type": "concept", "source_file": "src/content/module-16/04-tradeoff-case.md", "source_location": null, "source_url": null