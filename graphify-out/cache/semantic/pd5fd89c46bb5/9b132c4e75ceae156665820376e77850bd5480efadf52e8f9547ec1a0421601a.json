{"nodes": [{"id": "src_content_module_03_04_cache_invalidation", "label": "Cache invalidation", "file_type": "document", "source_file": "src/content/module-03/04-cache-invalidation.md"}, {"id": "src_content_module_03_04_cache_invalidation_cache_invalidation_problem", "label": "Cache invalidation problem", "file_type": "concept", "source_file": "src/content/module-03/04-cache-invalidation.md", "rationale": "real data changed but the cached copy (the price tag) still shows the old value"}, {"id": "src_content_module_03_04_cache_invalidation_strategy_ttl", "label": "Strategy: TTL expiry", "file_type": "concept", "source_file": "src/content/module-03/04-cache-invalidation.md"}, {"id": "src_content_module_03_04_cache_invalidation_strategy_write_through", "label": "Strategy: Write-through update", "file_type": "concept", "source_file": "src/content/module-03/04-cache-invalidation.md"}, {"id": "src_content_module_03_04_cache_invalidation_strategy_cache_aside_invalidate", "label": "Strategy: Cache-aside with explicit invalidate", "file_type": "concept", "source_file": "src/content/module-03/04-cache-invalidation.md"}, {"id": "src_content_module_03_04_cache_invalidation_ttl_safety_net", "label": "TTL as a safety net", "file_type": "rationale", "source_file": "src/content/module-03/04-cache-invalidation.md", "rationale": "even with explicit invalidation, a short TTL guarantees a missed layer does not stay stale forever"}, {"id": "src_content_module_03_04_cache_invalidation_cache_stampede", "label": "Cache stampede (thundering herd)", "file_type": "concept", "source_file": "src/content/module-03/04-cache-invalidation.md", "rationale": "a hot key expires at once and thousands of requests hit the DB simultaneously; mitigate with lock on miss or staggered TTL"}, {"id": "src_content_module_03_04_cache_invalidation_lock_on_miss", "label": "Lock on miss (single flight)", "file_type": "concept", "source_file": "src/content/module-03/04-cache-invalidation.md"}, {"id": "src_content_mod