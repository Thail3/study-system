{"nodes": [{"id": "src_content_module_53_03_observability_cost_finops", "label": "Observability Cost and FinOps (lesson)", "file_type": "document", "source_file": "src/content/module-53/03-observability-cost-finops.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_53_03_observability_cost_finops_observability_cost_finops", "label": "Observability Cost Control (FinOps)", "file_type": "rationale", "source_file": "src/content/module-53/03-observability-cost-finops.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Collecting every log, metric and trace everywhere can cost more than the infrastructure observed; control cost per signal and across all three together."}, {"id": "src_content_module_53_03_observability_cost_finops_log_volume_cost", "label": "Log Volume Cost", "file_type": "concept", "source_file": "src/content/module-53/03-observability-cost-finops.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_53_03_observability_cost_finops_trace_volume_cost", "label": "Trace Volume Cost", "file_type": "concept", "source_file": "src/content/module-53/03-observability-cost-finops.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_53_03_observability_cost_finops_metric_cardinality_cost", "label": "Metric Cardinality Cost", "file_type": "concept", "source_file": "src/content/module-53/03-observability-cost-finops.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_53_03_observability_cost_finops_tiered_retention", "label": "Tiered Retention (hot/warm/cold)", "file_type": "rationale", "source_file": "src/content/module-53/03-observability-cost-finops.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New data is queried far more than old data, so move older data to slower, cheaper storage tiers instead of keeping everything on the most expensive tier."}, {"id": "src_content_module_53_03_observability_cost_finops_conditional_sampling", "label": "Conditional (Smart) Sampling", "file_type": "rationale", "source_file": "src/content/module-53/03-observability-cost-finops.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep 100% of ERROR/WARN logs, sample INFO/DEBUG, and keep error or slow traces via tail-based sampling; cuts cost without losing incident data."}, {"id": "src_content_module_53_03_observability_cost_finops_tail_based_sampling", "label": "Tail-based Sampling", "file_type": "concept", "source_file": "src/content/module-53/03-observability-cost-finops.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_53_03_observability_cost_finops_uniform_sampling_pitfall", "label": "Uniform Sampling Pitfall", "file_type": "rationale", "source_file": "src/content/module-53/03-observability-cost-finops.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A flat 1% sample across all levels may drop the logs of a rare (0.1%) incident entirely; sampling must respect data importance."}, {"id": "src_content_module_53_03_observability_cost_finops_cardinality_explosion", "label": "Cardinality Explosion", "file_type": "concept", "source_file": "src/content/module-53/03-observability-cost-finops.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_53_03_observability_cost_finops_log_sampling", "label": "Log Sampling", "file_type": "concept", "source_file": "src/content/modul