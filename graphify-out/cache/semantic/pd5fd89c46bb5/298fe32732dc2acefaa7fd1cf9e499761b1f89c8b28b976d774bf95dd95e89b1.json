{"nodes": [{"id": "src_content_module_01_05_realtime_communication", "label": "Realtime communication", "file_type": "document", "source_file": "src/content/module-01/05-realtime-communication.md"}, {"id": "src_content_module_01_05_realtime_communication_short_polling", "label": "Short Polling", "file_type": "concept", "source_file": "src/content/module-01/05-realtime-communication.md"}, {"id": "src_content_module_01_05_realtime_communication_long_polling", "label": "Long Polling", "file_type": "concept", "source_file": "src/content/module-01/05-realtime-communication.md"}, {"id": "src_content_module_01_05_realtime_communication_sse", "label": "Server-Sent Events (SSE)", "file_type": "concept", "source_file": "src/content/module-01/05-realtime-communication.md"}, {"id": "src_content_module_01_05_realtime_communication_websocket", "label": "WebSocket", "file_type": "concept", "source_file": "src/content/module-01/05-realtime-communication.md"}, {"id": "src_content_module_01_05_realtime_communication_technique_comparison", "label": "Comparison of the 4 realtime techniques", "file_type": "concept", "source_file": "src/content/module-01/05-realtime-communication.md"}, {"id": "src_content_module_01_05_realtime_communication_choose_by_need", "label": "Choose the realtime technique by actual need", "file_type": "rationale", "source_file": "src/content/module-01/05-realtime-communication.md", "rationale": "WebSocket has higher overhead (reconnects, two-way state); SSE is simpler for listen-only; polling is fine when seconds of delay are acceptable; do not pick the fastest by default"}, {"id": "src_content_module_01_05_realtime_communication_backpressure", "label": "Backpressure", "file_type": "concept", "source_file": "src/content/module-01/05-realtime-communication.md", "rationale": "server sends faster than the client processes so buffers grow; fix by sampling/coalescing and sending only the latest value every short interval (e.g. 100ms)"}, {"id": "src_content_module_01_05_realtime_communication_reconnect_with_sequence", "label": "Reconnect with sequence numbers", "file_type": "concept", "source_file": "src/content/module-01/05-realtime-communication.md", "rationale": "each event carries a sequence/message ID; after reconnecting the client reports the last ID it saw so the server resends only missed events"}, {"id": "src_content_module_01_05_realtime_communication_reconnection_storm", "label": "Reconnection storm", "file_type": "concept", "source_file": "src/content/module-01/05-realtime-communication.md", "rationale": "server restart drops many connections which all reconnect at once and spike the freshly restarted server"}, {"id": "src_content_module_01_05_realtime_communication_jitter_backoff", "label": "Jitter and exponential backoff on reconnect", "file_type": "concept", "source_file": "src/content/module-01/05-realtime-communication.md"}, {"id": "src_content_module_01_05_realtime_communication_latency_race_demo", "label": "RealtimeLatencyRaceDemo", "file_type": "code", "source_file": "src/content/module-01/05-realtime-communication.md"}], "edges": [{"source": "src_content_module_01_05_realtime_communication", "target": "src_content_module_01_05_realtime_communication_technique_comparison", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-01/05-realtime-communication.md", "weight": 1.0}, {"source": "src_content_module_01_05_realtime_communication", "target": "src_content_module_01_03_http_lifecycle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-01/05-realtime-communication.md", "weight": 1.0}, {"source": "src_content_module_01_05_realtime_communication", "target": "src_content_module_01_05_realtime_communication_latency_race_demo", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-01/05-realtime-communication.md", "weight": 1.0}, {"sour