{"nodes": [{"id": "src_content_module_36_01_error_budget_burn_rate", "label": "Error Budget Burn Rate", "file_type": "document", "source_file": "src/content/module-36/01-error-budget-burn-rate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_36_01_error_budget_burn_rate_burn_rate", "label": "Error Budget Burn Rate", "file_type": "concept", "source_file": "src/content/module-36/01-error-budget-burn-rate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rate budget is consumed relative to the rate that would exhaust it exactly at end of SLO window; 1x = on plan, 100x = budget gone in hours. Alerts earlier than waiting for SLI to drop below SLO."}, {"id": "src_content_module_36_01_error_budget_burn_rate_multi_window_alerting", "label": "Multi-Window Multi-Burn-Rate Alerting", "file_type": "concept", "source_file": "src/content/module-36/01-error-budget-burn-rate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Combine short and long windows to confirm a real, sustained problem: short window catches fast, long window filters transient spikes."}, {"id": "src_content_module_36_01_error_budget_burn_rate_critical_burn_alert", "label": "Critical Burn-Rate Alert (14.4x, 5m/1h, page)", "file_type": "concept", "source_file": "src/content/module-36/01-error-budget-burn-rate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_36_01_error_budget_burn_rate_warning_burn_alert", "label": "Warning Burn-Rate Alert (6x, 30m/6h, ticket)", "file_type": "concept", "source_file": "src/content/module-36/01-error-budget-burn-rate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_36_01_error_budget_burn_rate_observability_metric_chain", "label": "Golden Signals to Burn Rate Chain", "file_type": "rationale", "source_file": "src/content/module-36/01-error-budget-burn-rate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Golden Signals measure -> SLI picks user-critical ones -> SLO sets target -> Error Budget computes quota -> Burn Rate alerts on abnormal consumption."}, {"id": "src_content_module_36_01_error_budget_burn_rate_burn_rate_vs_static_threshold", "label": "Burn Rate Alert vs Static Error-Rate Threshold", "file_type": "rationale", "source_file": "src/content/module-36/01-error-budget-burn-rate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Burn rate has a time dimension (time-to-exhaust), so severity can match urgency; a static threshold lacks it and gives false positives on short spikes."}, {"id": "src_content_module_36_01_error_budget_burn_rate_google_sre", "label": "Google SRE", "file_type": "concept", "source_file": "src/content/module-36/01-error-budget-burn-rate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "src_content_module_36_01_error_budget_burn_rate", "target": "src_content_module_36_01_error_budget_burn_rate_burn_rate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-36/01-error-budget-burn-rate.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_36_01_error_budget_burn_rate_burn_rate", "target": "src_content_module_35_03_sli_slo_dashboard_error_budget", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-36/01-error-budget-burn-rate.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_36_01_error_budget_burn_rate_burn_rate", "target": "src