{"nodes": [{"id": "src_content_module_05_03_consistency_models_strong_consistency", "label": "Strong Consistency", "file_type": "concept", "source_file": "src/content/module-05/03-consistency-models.md", "source_location": null, "rationale": "Always reads the latest value with all nodes in agreement, at the cost of waiting for replica sync (higher latency); suited to bank balances and stock."}, {"id": "src_content_module_05_03_consistency_models_eventual_consistency", "label": "Eventual Consistency", "file_type": "concept", "source_file": "src/content/module-05/03-consistency-models.md", "source_location": null, "rationale": "Any node answers immediately and data converges later; accepted for like counts, view counts, feeds where short staleness does not hurt correctness."}, {"id": "src_content_module_05_03_consistency_models_inconsistency_window", "label": "Inconsistency Window", "file_type": "concept", "source_file": "src/content/module-05/03-consistency-models.md", "source_location": null, "rationale": "Period when some replicas know the new value and others do not; good systems keep it to milliseconds or a few seconds."}, {"id": "src_content_module_05_03_consistency_models_read_your_own_writes", "label": "Read-Your-Own-Writes", "file_type": "concept", "source_file": "src/content/module-05/03-consistency-models.md", "source_location": null, "rationale": "Middle ground: the writer immediately sees their own write even if others do not yet."}, {"id": "src_content_module_05_03_consistency_models_quorum_consistency", "label": "Quorum Consistency (W + R > N)", "file_type": "rationale", "source_file": "src/content/module-05/03-consistency-models.md", "source_location": null, "rationale": "If W write-acks plus R read-replicas exceed N copies, the write set and read set always overlap, guaranteeing the latest value is seen; W and R can be tuned for faster reads or writes."}, {"id": "src_content_module_05_03_consistency_models_causal_consistency", "label": "Causal Consistency", "file_type": "concept", "source_file": "src/content/module-05/03-consistency-models.md", "source_location": null, "rationale": "Guarantees causally related events are read in order (a reply is never seen before its parent comment), even though unrelated events may reorder."}, {"id": "src_content_module_05_03_consistency_models_vector_clock", "label": "Vector Clock", "file_type": "concept", "source_file": "src/content/module-05/03-consistency-models.md", "source_location": null, "rationale": "Detects true happens-before ordering and concurrent conflicting writes, unlike wall-clock timestamps that drift between machines."}, {"id": "src_content_module_05_03_consistency_models_crdt", "label": "CRDT (Conflict-free Replicated Data Type)", "file_type": "concept", "source_file": "src/content/module-05/03-consistency-models.md", "source_location": null, "rationale": "Data structures designed to merge automatically with no conflicts, e.g. a counter whose final value is the same regardless of merge order."}, {"id": "src_content_module_05_03_consistency_models_last_write_wins", "label": "Last-Write-Wins", "file_type": "concept", "source_file": "src/content/module-05/03-consistency-models.md", "source_location": null, "rationale": "Simplest conflict resolution but can lose data if the wrong write wins."}], "edges": [{"source": "src_content_module_05_03_consistency_models_strong_consistency", "target": "src_content_module_05_03_consistency_models_eventual_consistency", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-05/03-consistency-models.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_05_03_consistency_models_eventual_consistency", "target": "src_content_module_05_03_consistency_models_inconsistency_window", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-05/03-consistency-models.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_05_03_consistency_models_read_your_own_writes", "target": "src_content_module_05_03_consistency_models_eventual_consistency", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-05/03-consistency-models.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_05_03_consistency_models_quorum_consistency", "target": "src_content_module_05_03_consistency_models_strong_consistency", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "src/content/module-05/03-consistency-models.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_05_03_consistency_models_causal_consistency", "target": "src_content_module_05_03_consistency_models_eventual_consistency", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-05/03-consistency-models.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_05_03_consistency_models_vector_clock", "target": "src_content_module_05_03_consistency_models_causal_consistency", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "src/content/module-05/03-consistency-models.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_05_03_consistency_models_eventual_consistency", "target": "src_content_module_05_01_cap_theorem_cap_theorem", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-05/03-consistency-models.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_05_03_consistency_models_quorum_consistency", "target": "src_content_module_04_05_consensus_leader_election_majority_quorum", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "src/content/module-05/03-consistency-models.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_05_03_consistency_models_crdt", "target": "src_content_module_05_03_consistency_models_last_write_wins", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-05/03-consistency-models.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "module_05_conflict_resolution_strategies", "label": "Concurrent Write Conflict Resolution Strategies", "nodes": ["src_content_module_05_03_consistency_models_last_write_wins", "src_content_module_05_03_consistency_models_vector_clock", "src_content_module_05_03_consistency_models_crdt"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-05/03-consistency-models.md"}]}