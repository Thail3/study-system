{"nodes": [{"id": "src_content_module_51_02_gitops", "label": "GitOps (lesson)", "file_type": "document", "source_file": "src/content/module-51/02-gitops.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_51_02_gitops_gitops", "label": "GitOps", "file_type": "rationale", "source_file": "src/content/module-51/02-gitops.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Git repo is the single source of truth for desired state; an in-cluster agent pulls and reconciles continuously, so CI never needs credentials into the cluster and every change is in git history."}, {"id": "src_content_module_51_02_gitops_push_based_deploy", "label": "Push-based Deploy", "file_type": "concept", "source_file": "src/content/module-51/02-gitops.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_51_02_gitops_desired_state", "label": "Desired State in Git", "file_type": "concept", "source_file": "src/content/module-51/02-gitops.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_51_02_gitops_reconcile_loop", "label": "Reconcile Loop", "file_type": "rationale", "source_file": "src/content/module-51/02-gitops.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Endless loop reads desired state from Git, reads actual state from cluster, applies diff; self-heals drift, so manual cluster edits are reverted on the next cycle."}, {"id": "src_content_module_51_02_gitops_manual_drift_revert", "label": "Manual Cluster Edit Reverted by Reconciler", "file_type": "rationale", "source_file": "src/content/module-51/02-gitops.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "kubectl edits made outside Git vanish because the reconciler enforces Git; correct fix, even in an incident, is to commit to Git."}, {"id": "src_content_module_51_02_gitops_push_vs_pull_security", "label": "Pull-based Smaller Attack Surface", "file_type": "rationale", "source_file": "src/content/module-51/02-gitops.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Push-based requires external CI to hold cluster credentials (compromised pipeline means cluster access); pull-based agent lives inside the cluster so no external credential is distributed."}, {"id": "src_content_module_51_02_gitops_argocd", "label": "ArgoCD", "file_type": "concept", "source_file": "src/content/module-51/02-gitops.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_51_02_gitops_flux", "label": "Flux", "file_type": "concept", "source_file": "src/content/module-51/02-gitops.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_51_02_gitops_git_revert_rollback", "label": "Rollback via git revert", "file_type": "concept", "source_file": "src/content/module-51/02-gitops.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_51_02_gitops_gitopsreconcilediem", "label": "GitOpsReconcileDemo", "file_type": "code", "source_file": "src/content/module-51/02-gitops.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "src_content_module_51_02_gitops", "target": "src_content_module_51_02_gitops_gitops", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-51/02-gitops.md", "source_location": null, "weight": 1.0}, {"source": "src_