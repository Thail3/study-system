{"nodes": [{"id": "src_content_module_07_05_distributed_transactions_saga_saga", "label": "Saga Pattern", "file_type": "rationale", "source_file": "src/content/module-07/05-distributed-transactions-saga.md", "source_location": null, "rationale": "A chain of local transactions, each committed immediately, with compensating actions to undo earlier steps if a later one fails; trades atomicity for speed and no cross-service locks."}, {"id": "src_content_module_07_05_distributed_transactions_saga_compensating_transaction", "label": "Compensating Transaction", "file_type": "concept", "source_file": "src/content/module-07/05-distributed-transactions-saga.md", "source_location": null, "rationale": "A real undo action (cancel hotel, cancel flight), not a database rollback."}, {"id": "src_content_module_07_05_distributed_transactions_saga_choreography", "label": "Saga Choreography", "file_type": "concept", "source_file": "src/content/module-07/05-distributed-transactions-saga.md", "source_location": null, "rationale": "Services publish events and react on their own with no central coordinator; the overall logic gets harder to trace as steps grow."}, {"id": "src_content_module_07_05_distributed_transactions_saga_orchestration", "label": "Saga Orchestration", "file_type": "concept", "source_file": "src/content/module-07/05-distributed-transactions-saga.md", "source_location": null, "rationale": "A central Saga Orchestrator knows the steps and compensations; easier to debug but must itself be fault tolerant."}, {"id": "src_content_module_07_05_distributed_transactions_saga_two_phase_commit", "label": "Two-Phase Commit (2PC)", "file_type": "concept", "source_file": "src/content/module-07/05-distributed-transactions-saga.md", "source_location": null, "rationale": "Locks resources across all databases until everyone votes, which is slow and deadlock-prone across networks; Saga is preferred for scaled microservices."}, {"id": "src_content_module_07_05_distributed_transactions_saga_semantic_lock", "label": "Semantic Lock", "file_type": "rationale", "source_file": "src/content/module-07/05-distributed-transactions-saga.md", "source_location": null, "rationale": "Business-level flag such as PENDING_CONFIRMATION marking a record as mid-saga so readers do not treat intermediate states (dirty reads) as final."}, {"id": "src_content_module_07_05_distributed_transactions_saga_database_transaction", "label": "Database Transaction (BEGIN/COMMIT/ROLLBACK)", "file_type": "concept", "source_file": "src/content/module-07/05-distributed-transactions-saga.md", "source_location": null, "rationale": "Works within one database but cannot span the separate databases of multiple microservices."}], "edges": [{"source": "src_content_module_07_05_distributed_transactions_saga_database_transaction", "target": "src_content_module_07_05_distributed_transactions_saga_saga", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-07/05-distributed-transactions-saga.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_07_05_distributed_transactions_saga_saga", "target": "src_content_module_07_05_distributed_transactions_saga_compensating_transaction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-07/05-distributed-transactions-saga.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_07_05_distributed_transactions_saga_saga", "target": "src_content_module_07_05_distributed_transactions_saga_choreography", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-07/05-distributed-transactions-saga.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_07_05_distributed_transactions_saga_saga", "target": "src_content_module_07_05_distributed_transactions_saga_orchestration", "relation": "references", "confidence": "EXTRACTED",