{"nodes": [{"id": "src_content_module_06_03_pub_sub_pub_sub", "label": "Pub/Sub", "file_type": "concept", "source_file": "src/content/module-06/03-pub-sub.md", "source_location": null, "rationale": "One published message reaches all subscribers independently; the publisher need not know who listens, so adding a new subscriber needs no change to the publisher. Contrast with a queue where one consumer takes each message."}, {"id": "src_content_module_06_03_pub_sub_topic", "label": "Topic", "file_type": "concept", "source_file": "src/content/module-06/03-pub-sub.md", "source_location": null}, {"id": "src_content_module_06_03_pub_sub_consumer_lag", "label": "Consumer Lag", "file_type": "concept", "source_file": "src/content/module-06/03-pub-sub.md", "source_location": null, "rationale": "Gap between latest published message and a consumer's position; if lag exceeds retention, unread messages are deleted, so lag must be monitored and consumers scaled."}, {"id": "src_content_module_06_03_pub_sub_retention_period", "label": "Retention Period", "file_type": "concept", "source_file": "src/content/module-06/03-pub-sub.md", "source_location": null, "rationale": "Pub/Sub topics keep messages for a limited time (Kafka default 7 days), unlike queues where messages stay until acked."}, {"id": "src_content_module_06_03_pub_sub_offset", "label": "Subscriber Offset", "file_type": "concept", "source_file": "src/content/module-06/03-pub-sub.md", "source_location": null, "rationale": "Each subscriber tracks its own read position so slow subscribers do not block fast ones."}, {"id": "src_content_module_06_03_pub_sub_kafka", "label": "Kafka", "file_type": "concept", "source_file": "src/content/module-06/03-pub-sub.md", "source_location": null}], "edges": [{"source": "src_content_module_06_03_pub_sub_pub_sub", "target": "src_content_module_06_02_message_queue_message_queue", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/conte