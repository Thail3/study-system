{"nodes": [{"id": "src_content_module_52_01_iac_fundamentals", "label": "IaC Fundamentals (lesson)", "file_type": "document", "source_file": "src/content/module-52/01-iac-fundamentals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_52_01_iac_fundamentals_infrastructure_as_code", "label": "Infrastructure as Code (IaC)", "file_type": "rationale", "source_file": "src/content/module-52/01-iac-fundamentals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Describe servers, networks and databases as code (a blueprint) instead of clicking in a cloud console."}, {"id": "src_content_module_52_01_iac_fundamentals_declarative_iac", "label": "Declarative IaC", "file_type": "concept", "source_file": "src/content/module-52/01-iac-fundamentals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Write the desired end state; the tool diffs against reality and decides what to create/change/delete. Dominant style today."}, {"id": "src_content_module_52_01_iac_fundamentals_imperative_iac", "label": "Imperative Provisioning Scripts", "file_type": "concept", "source_file": "src/content/module-52/01-iac-fundamentals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_52_01_iac_fundamentals_idempotency", "label": "Idempotency", "file_type": "concept", "source_file": "src/content/module-52/01-iac-fundamentals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_52_01_iac_fundamentals_plan_apply_workflow", "label": "Plan then Apply Workflow", "file_type": "rationale", "source_file": "src/content/module-52/01-iac-fundamentals.md", "source_location": null, "source_url": null, "captured_at": null, "author