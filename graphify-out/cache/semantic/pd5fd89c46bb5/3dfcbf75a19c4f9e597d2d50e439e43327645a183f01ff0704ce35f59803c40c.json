{"nodes": [{"id": "src_content_module_27_02_parameters_vs_structure", "label": "Parameters vs Structure", "file_type": "document", "source_file": "src/content/module-27/02-parameters-vs-structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_27_02_parameters_vs_structure_three_groups", "label": "Three Leverage Groups: Parameters / Structure / Goals & Paradigm", "file_type": "concept", "source_file": "src/content/module-27/02-parameters-vs-structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The 12 levels collapse into Parameters (12-9), Structure (8-4), Goals & Paradigm (3-1) for fast decisions."}, {"id": "src_content_module_27_02_parameters_vs_structure_escalation_rule", "label": "Move-Up-When-Symptom-Recurs Rule", "file_type": "rationale", "source_file": "src/content/module-27/02-parameters-vs-structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If parameter tuning keeps failing suspect structure; if structure fails suspect goals/paradigm. Avoids both premature paradigm changes (wasted political energy) and endless parameter tweaking."}, {"id": "src_content_module_27_02_parameters_vs_structure_gaming_the_metric", "label": "Gaming the Metric", "file_type": "concept", "source_file": "src/content/module-27/02-parameters-vs-structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Teams write weak tests that pass the coverage threshold without testing anything, showing the parameter alone is insufficient."}, {"id": "src_content_module_27_02_parameters_vs_structure_incomplete_test_pr_example", "label": "Incomplete-Test PR Example (three-level climb)", "file_type": "concept", "source_file": "src/content/module-27/02-parameters-vs-structure.md", "source_l