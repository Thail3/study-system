{"nodes": [{"id": "src_content_module_33_03_centralized_log_pipeline_centralized_logging", "label": "Centralized Logging", "file_type": "concept", "source_file": "src/content/module-33/03-centralized-log-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_33_03_centralized_log_pipeline_log_shipper", "label": "Log Shipper (Filebeat, Fluentd, Promtail)", "file_type": "concept", "source_file": "src/content/module-33/03-centralized-log-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs beside each service and forwards logs so service does not write directly to storage and network failures do not hurt the main service."}, {"id": "src_content_module_33_03_centralized_log_pipeline_log_buffer", "label": "Log Buffer (Kafka)", "file_type": "concept", "source_file": "src/content/module-33/03-centralized-log-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_33_03_centralized_log_pipeline_elk_stack", "label": "ELK Stack (Elasticsearch)", "file_type": "concept", "source_file": "src/content/module-33/03-centralized-log-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Indexes every field of every log line for powerful full-text search at much higher storage/memory cost."}, {"id": "src_content_module_33_03_centralized_log_pipeline_grafana_loki", "label": "Grafana Loki", "file_type": "concept", "source_file": "src/content/module-33/03-centralized-log-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately indexes only a few labels (like Prometheus) and stores compressed log bodies, avoiding cardinality blow-up for far lower cost at the price of slow