{"nodes": [{"id": "src_content_module_05_01_cap_theorem_cap_theorem", "label": "CAP Theorem", "file_type": "concept", "source_file": "src/content/module-05/01-cap-theorem.md", "source_location": null, "rationale": "Partitions always happen in real distributed systems, so partition tolerance is mandatory; the real question is whether to choose Consistency or Availability when the network splits."}, {"id": "src_content_module_05_01_cap_theorem_consistency_cap", "label": "Consistency (CAP)", "file_type": "concept", "source_file": "src/content/module-05/01-cap-theorem.md", "source_location": null, "rationale": "All nodes queried at the same time return exactly the same data (linearizability across machines)."}, {"id": "src_content_module_05_01_cap_theorem_availability", "label": "Availability", "file_type": "concept", "source_file": "src/content/module-05/01-cap-theorem.md", "source_location": null}, {"id": "src_content_module_05_01_cap_theorem_partition_tolerance", "label": "Partition Tolerance", "file_type": "concept", "source_file": "src/content/module-05/01-cap-theorem.md", "source_location": null}, {"id": "src_content_module_05_01_cap_theorem_cp_vs_ap", "label": "CP vs AP Choice", "file_type": "rationale", "source_file": "src/content/module-05/01-cap-theorem.md", "source_location": null, "rationale": "Banks lean CP (wrong balance is worse than slow service); social feeds lean AP. The choice can differ per operation or per dataset (e.g. CP for inventory, AP for product reviews), not one label for the whole system."}, {"id": "src_content_module_05_01_cap_theorem_acid_consistency", "label": "Consistency (ACID)", "file_type": "concept", "source_file": "src/content/module-05/01-cap-theorem.md", "source_location": null, "rationale": "Data does not violate constraints within a single transaction; a different dimension from CAP consistency, so an ACID system can still be AP."}], "edges": [{"source": "src_content_module_05_01_cap_theorem_cap_theorem", "target": "src_content_module_05_01_cap_theorem_consistency_cap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-05/01-cap-theorem.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_05_01_cap_theorem_cap_theorem", "target": "src_content_module_05_01_cap_theorem_availability", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-05/01-cap-theorem.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_05_01_cap_theorem_cap_theorem", "target": "src_content_module_05_01_cap_theorem_partition_tolerance", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-05/01-cap-theorem.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_05_01_cap_theorem_cap_theorem", "target": "src_content_module_05_01_cap_theorem_cp_vs_ap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-05/01-cap-theorem.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_05_01_cap_theorem_acid_consistency", "target": "src_content_module_05_01_cap_theorem_consistency_cap", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-05/01-cap-theorem.md", "source_location": null, "weight": 1.0}], "hyperedges": []}