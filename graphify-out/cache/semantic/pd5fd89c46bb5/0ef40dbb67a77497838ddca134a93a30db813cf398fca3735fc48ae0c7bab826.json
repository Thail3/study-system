{"nodes": [{"id": "src_content_module_07_02_rest_vs_grpc_rest", "label": "REST", "file_type": "concept", "source_file": "src/content/module-07/02-rest-vs-grpc.md", "source_location": null, "rationale": "HTTP verbs with human-readable JSON and broad tooling support; best for public and third-party APIs."}, {"id": "src_content_module_07_02_rest_vs_grpc_grpc", "label": "gRPC", "file_type": "concept", "source_file": "src/content/module-07/02-rest-vs-grpc.md", "source_location": null, "rationale": "Schema-first binary protocol with built-in streaming; faster and best for internal service-to-service traffic where both sides share the schema."}, {"id": "src_content_module_07_02_rest_vs_grpc_protocol_buffers", "label": "Protocol Buffers", "file_type": "concept", "source_file": "src/content/module-07/02-rest-vs-grpc.md", "source_location": null}, {"id": "src_content_module_07_02_rest_vs_grpc_graphql", "label": "GraphQL", "file_type": "concept", "source_file": "src/content/module-07/02-rest-vs-grpc.md", "source_location": null, "rationale": "Client specifies the exact fields it needs in one query, fixing over/under-fetching and suiting diverse clients, at the cost of resolver complexity and harder HTTP caching."}, {"id": "src_content_module_07_02_rest_vs_grpc_over_under_fetching", "label": "Over-fetching and Under-fetching", "file_type": "concept", "source_file": "src/content/module-07/02-rest-vs-grpc.md", "source_location": null, "rationale": "Server-fixed response shapes in REST and gRPC return too much data or force multiple calls."}], "edges": [{"source": "src_content_module_07_02_rest_vs_grpc_rest", "target": "src_content_module_07_02_rest_vs_grpc_grpc", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-07/02-rest-vs-grpc.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_07_02_rest_vs_grpc_grpc", "target": "src_content_module_07_02_rest_vs_grpc_protocol_buffers", "relat