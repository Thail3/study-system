{"nodes": [{"id": "src_content_module_16_05_architecture_tactics_advanced_doc", "label": "Architecture Tactics Advanced (note)", "file_type": "document", "source_file": "src/content/module-16/05-architecture-tactics-advanced.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_16_05_architecture_tactics_advanced_architecture_tactics", "label": "Architecture Tactics", "file_type": "concept", "source_file": "src/content/module-16/05-architecture-tactics-advanced.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Small design decisions targeting one specific quality attribute; smaller and more specific than architectural patterns, which are built from many tactics."}, {"id": "src_content_module_16_05_architecture_tactics_advanced_architectural_pattern", "label": "Architectural Pattern / Style", "file_type": "concept", "source_file": "src/content/module-16/05-architecture-tactics-advanced.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_16_05_architecture_tactics_advanced_tactic_vs_pattern", "label": "Tactics and Patterns Live at Different Layers", "file_type": "rationale", "source_file": "src/content/module-16/05-architecture-tactics-advanced.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A pattern says the big picture; tactics are the actual mechanisms that make it work. One tactic (e.g. heartbeat) can serve many patterns."}, {"id": "src_content_module_16_05_architecture_tactics_advanced_detection_tactic", "label": "Detection Tactic (Availability)", "file_type": "concept", "source_file": "src/content/module-16/05-architecture-tactics-advanced.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "