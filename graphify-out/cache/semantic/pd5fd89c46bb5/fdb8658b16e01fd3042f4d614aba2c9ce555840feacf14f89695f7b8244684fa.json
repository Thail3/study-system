{"nodes": [{"id": "src_content_module_07_03_api_gateway_api_gateway", "label": "API Gateway", "file_type": "concept", "source_file": "src/content/module-07/03-api-gateway.md", "source_location": null, "rationale": "Single entry point so clients need not know each microservice; routes by content, unlike a plain load balancer. It becomes a single point of failure, so run more than one."}, {"id": "src_content_module_07_03_api_gateway_gateway_responsibilities", "label": "Gateway Responsibilities (routing, central auth, rate limit, aggregation, logging)", "file_type": "concept", "source_file": "src/content/module-07/03-api-gateway.md", "source_location": null, "rationale": "Centralizing cross-cutting concerns avoids duplicating auth, rate limiting and logging in every service."}, {"id": "src_content_module_07_03_api_gateway_bff", "label": "BFF (Backend For Frontend)", "file_type": "rationale", "source_file": "src/content/module-07/03-api-gateway.md", "source_location": null, "rationale": "A separate gateway per client type (mobile, web) so each frontend team owns its own aggregation logic and the shared gateway does not become an organizational bottleneck."}], "edges": [{"source": "src_content_module_07_03_api_gateway_api_gateway", "target": "src_content_module_07_01_monolith_vs_microservices_microservices", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-07/03-api-gateway.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_07_03_api_gateway_api_gateway", "target": "src_content_module_07_03_api_gateway_gateway_responsibilities", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-07/03-api-gateway.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_07_03_api_gateway_gateway_responsibilities", "target": "src_content_module_08_01_rate_limiting_rate_limiting", "relation": "references", "confidence": "