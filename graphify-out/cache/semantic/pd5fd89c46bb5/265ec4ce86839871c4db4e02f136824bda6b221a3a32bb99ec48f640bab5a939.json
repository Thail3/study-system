{"nodes": [{"id": "src_content_module_08_02_circuit_breaker_circuit_breaker", "label": "Circuit Breaker", "file_type": "rationale", "source_file": "src/content/module-08/02-circuit-breaker.md", "source_location": null, "rationale": "Fail fast instead of waiting on a failing downstream, so callers do not exhaust threads and the failure does not cascade."}, {"id": "src_content_module_08_02_circuit_breaker_circuit_states", "label": "Circuit Breaker States (Closed, Open, Half-Open)", "file_type": "concept", "source_file": "src/content/module-08/02-circuit-breaker.md", "source_location": null, "rationale": "Closed passes traffic and counts failures; Open rejects immediately; Half-Open lets one trial request through to decide whether to close or reopen."}, {"id": "src_content_module_08_02_circuit_breaker_thread_pool_exhaustion", "label": "Thread Pool Exhaustion", "file_type": "concept", "source_file": "src/content/module-08/02-circuit-breaker.md", "source_location": null, "rationale": "Requests waiting on a dead downstream until timeout consume all threads, taking the calling service down too."}, {"id": "src_content_module_08_02_circuit_breaker_bulkhead", "label": "Bulkhead Pattern", "file_type": "rationale", "source_file": "src/content/module-08/02-circuit-breaker.md", "source_location": null, "rationale": "Give each downstream its own thread or connection pool quota so one slow dependency cannot starve calls to others; complements the circuit breaker."}], "edges": [{"source": "src_content_module_08_02_circuit_breaker_circuit_breaker", "target": "src_content_module_08_02_circuit_breaker_circuit_states", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/02-circuit-breaker.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_02_circuit_breaker_thread_pool_exhaustion", "target": "src_content_module_08_02_circuit_breaker_circuit_breaker", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/02-circuit-breaker.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_02_circuit_breaker_thread_pool_exhaustion", "target": "src_content_module_08_02_circuit_breaker_bulkhead", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/02-circuit-breaker.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_02_circuit_breaker_bulkhead", "target": "src_content_module_08_02_circuit_breaker_circuit_breaker", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/02-circuit-breaker.md", "source_location": null, "weight": 1.0}], "hyperedges": []}