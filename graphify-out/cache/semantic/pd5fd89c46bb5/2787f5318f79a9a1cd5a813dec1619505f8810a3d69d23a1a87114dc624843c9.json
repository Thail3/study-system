ed tables)", "file_type": "concept", "source_file": "src/content/module-15/01-bounded-context.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_15_01_bounded_context_wrong_boundary_risk", "label": "Wrong Boundaries Yield Chatty Pseudo-Monolith Services", "file_type": "rationale", "source_file": "src/content/module-15/01-bounded-context.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cutting microservices by database table instead of business meaning yields services that call each other constantly, little better than a monolith split into files; getting bounded contexts right is the foundation of large-system design."}, {"id": "src_content_module_15_01_bounded_context_adr_product_split", "label": "ADR: Split Product Model into Bounded Contexts by Department", "file_type": "rationale", "source_file": "src/content/module-15/01-bounded-context.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A shared products table caused cross-department regressions and conflicting meanings of 'product status'; separate models per context, connected via API/event, at the cost of cross-context consistency work."}], "edges": [{"source": "src_content_module_15_01_bounded_context_bounded_context", "target": "src_content_module_15_01_bounded_context_ddd", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-15/01-bounded-context.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_15_01_bounded_context_shared_domain_model", "target": "src_content_module_15_01_bounded_context_bounded_context", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-15/01-bounded-context.md", "source_location": null, "weight": 1.