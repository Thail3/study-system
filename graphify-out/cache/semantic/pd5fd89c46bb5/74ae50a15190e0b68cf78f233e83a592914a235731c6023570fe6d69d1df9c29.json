{"nodes": [{"id": "src_content_module_30_02_defense_in_depth_defense_in_depth", "label": "Defense in Depth", "file_type": "rationale", "source_file": "src/content/module-30/02-defense-in-depth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Layer multiple independent protections (like submarine watertight compartments) so one breached layer does not collapse everything. Example: WAF plus parameterized queries, since the WAF can be bypassed by unknown payloads."}, {"id": "src_content_module_30_02_defense_in_depth_network_layer", "label": "Layer 1: Network (Firewall, WAF, DDoS protection)", "file_type": "concept", "source_file": "src/content/module-30/02-defense-in-depth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_30_02_defense_in_depth_identity_layer", "label": "Layer 2: Identity (Authentication, MFA, mTLS)", "file_type": "concept", "source_file": "src/content/module-30/02-defense-in-depth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_30_02_defense_in_depth_application_layer", "label": "Layer 3: Application (input validation, per-endpoint authorization)", "file_type": "concept", "source_file": "src/content/module-30/02-defense-in-depth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_30_02_defense_in_depth_data_layer", "label": "Layer 4: Data (encryption at rest, field-level encryption)", "file_type": "concept", "source_file": "src/content/module-30/02-defense-in-depth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_30_02_defense_in_depth_monitoring_layer", "label": "Layer 5: Monitoring (audit log, anomaly detection)", "file_type": "concept", "source_file": "src/content/module-30/02-defense-in-depth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_30_02_defense_in_depth_defense_diversity", "label": "Defense Diversity", "file_type": "rationale", "source_file": "src/content/module-30/02-defense-in-depth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Layers must use different mechanisms closing different vulnerability classes; two firewalls bypassed the same way are not independent layers."}, {"id": "src_content_module_30_02_defense_in_depth_adr_field_level_encryption", "label": "ADR: Field-level encryption for credit card data", "file_type": "rationale", "source_file": "src/content/module-30/02-defense-in-depth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auditor noted a directly breached database would leak plaintext cards despite firewall/WAF/auth; encrypt at field level with separate key management. Trade-off: query complexity and encrypt/decrypt overhead."}], "edges": [{"source": "src_content_module_30_02_defense_in_depth_defense_in_depth", "target": "src_content_module_30_02_defense_in_depth_network_layer", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-30/02-defense-in-depth.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_30_02_defense_in_depth_defense_in_depth", "target": "src_content_module_30_02_defense_in_depth_identity_layer", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-30/02-defense-in-depth.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_30_02_defense_in_depth_defense_in_depth", "target": "src_content_module_30_02_defense_in_depth_application_layer", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-30/02-defense-in-depth.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_30_02_defense_in_depth_defense_in_depth", "target": "src_content_module_30_02_defense_in_depth_data_layer", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-30/02-defense-in-depth.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_30_02_defense_in_depth_defense_in_depth", "target": "src_content_module_30_02_defense_in_depth_monitoring_layer", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-30/02-defense-in-depth.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_30_02_defense_in_depth_defense_in_depth", "target": "src_content_module_30_02_defense_in_depth_defense_diversity", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-30/02-defense-in-depth.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_30_02_defense_in_depth_identity_layer", "target": "src_content_module_30_01_zero_trust_architecture_mutual_tls", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-30/02-defense-in-depth.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_30_02_defense_in_depth_adr_field_level_encryption", "target": "src_content_module_30_02_defense_in_depth_defense_in_depth", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-30/02-defense-in-depth.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_30_02_defense_in_depth_adr_field_level_encryption", "target": "src_content_module_30_02