{"nodes": [{"id": "src_content_module_06_04_event_driven_event_driven_architecture", "label": "Event-Driven Architecture (EDA)", "file_type": "concept", "source_file": "src/content/module-06/04-event-driven.md", "source_location": null, "rationale": "Services communicate by announcing events rather than direct commands, giving loose coupling, resilience and independent scaling at the cost of harder debugging, eventual consistency and event ordering/duplicate concerns. Real systems mix both styles."}, {"id": "src_content_module_06_04_event_driven_event_bus", "label": "Event Bus", "file_type": "concept", "source_file": "src/content/module-06/04-event-driven.md", "source_location": null}, {"id": "src_content_module_06_04_event_driven_request_driven", "label": "Request-Driven (Direct Calls) Style", "file_type": "concept", "source_file": "src/content/module-06/04-event-driven.md", "source_location": null, "rationale": "Caller must know every downstream service and slow or failed services stall the chain (tight coupling); still right when an immediate answer is needed, e.g. card authorization."}, {"id": "src_content_module_06_04_event_driven_loose_coupling", "label": "Loose Coupling", "file_type": "rationale", "source_file": "src/content/module-06/04-event-driven.md", "source_location": null}, {"id": "src_content_module_06_04_event_driven_schema_registry", "label": "Schema Registry", "file_type": "concept", "source_file": "src/content/module-06/04-event-driven.md", "source_location": null, "rationale": "Central store of every event schema version that auto-checks compatibility before a new schema may be published."}, {"id": "src_content_module_06_04_event_driven_schema_compatibility", "label": "Backward/Forward-Compatible Event Schema Evolution", "file_type": "rationale", "source_file": "src/content/module-06/04-event-driven.md", "source_location": null, "rationale": "Subscribers deploy at different times, so only add optional fields, never remove or rename in use fields; deprecate first and delete once nobody depends on them."}], "edges": [{"source": "src_content_module_06_04_event_driven_event_driven_architecture", "target": "src_content_module_06_03_pub_sub_pub_sub", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-06/04-event-driven.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_06_04_event_driven_event_driven_architecture", "target": "src_content_module_06_04_event_driven_event_bus", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-06/04-event-driven.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_06_04_event_driven_event_driven_architecture", "target": "src_content_module_06_04_event_driven_loose_coupling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-06/04-event-driven.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_06_04_event_driven_request_driven", "target": "src_content_module_06_04_event_driven_event_driven_architecture", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-06/04-event-driven.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_06_04_event_driven_schema_registry", "target": "src_content_module_06_04_event_driven_schema_compatibility", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-06/04-event-driven.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_06_04_event_driven_event_driven_architecture", "target": "src_content_module_05_03_consistency_models_eventual_consistency", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-06/04-event-driven.md", "source_location": null, "weight":