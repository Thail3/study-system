{"nodes": [{"id": "src_content_module_30_04_secure_by_design_patterns_secure_by_design", "label": "Secure by Design", "file_type": "rationale", "source_file": "src/content/module-30/04-secure-by-design-patterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Security is part of the architecture from the blueprint, not a feature bolted on later."}, {"id": "src_content_module_30_04_secure_by_design_patterns_least_privilege", "label": "Least Privilege", "file_type": "rationale", "source_file": "src/content/module-30/04-secure-by-design-patterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every service, user and API key gets only the permissions needed, limiting blast radius if compromised."}, {"id": "src_content_module_30_04_secure_by_design_patterns_secrets_management", "label": "Secrets Management", "file_type": "rationale", "source_file": "src/content/module-30/04-secure-by-design-patterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Applications fetch short-lived credentials from a Secrets Manager (Vault, AWS Secrets Manager) at runtime instead of hardcoding them."}, {"id": "src_content_module_30_04_secure_by_design_patterns_hardcoded_credentials_antipattern", "label": "Hardcoded Credentials Anti-pattern", "file_type": "concept", "source_file": "src/content/module-30/04-secure-by-design-patterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_30_04_secure_by_design_patterns_trust_boundary_design", "label": "Trust Boundary Design", "file_type": "rationale", "source_file": "src/content/module-30/04-secure-by-design-patterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Threat modeling finds where trust boundaries are; secure by design makes every crossing validated, authenticated and sanitized from the start."}, {"id": "src_content_module_30_04_secure_by_design_patterns_pre_commit_secret_scan", "label": "Pre-commit Secret Scanning Hook", "file_type": "concept", "source_file": "src/content/module-30/04-secure-by-design-patterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_30_04_secure_by_design_patterns_adr_secrets_manager_migration", "label": "ADR: Move DB credentials from env vars to Secrets Manager", "file_type": "rationale", "source_file": "src/content/module-30/04-secure-by-design-patterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": ".env committed to git by accident forced emergency rotation; move to Secrets Manager with 90-day auto-rotation. Trade-off: new dependency (startup fails if it is down) and startup latency."}], "edges": [{"source": "src_content_module_30_03_threat_modeling_trust_boundary", "target": "src_content_module_30_04_secure_by_design_patterns_trust_boundary_design", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-30/04-secure-by-design-patterns.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_30_04_secure_by_design_patterns_secure_by_design", "target": "src_content_module_30_04_secure_by_design_patterns_least_privilege", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-30/04-secure-by-design-patterns.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_30_04_secure_by_design_patterns_secure_by_design", "target": "src_content_module_30_04_secure_by_design_patterns_secrets_management", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "c