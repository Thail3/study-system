{"nodes": [{"id": "src_content_module_31_02_four_golden_signals_four_golden_signals", "label": "Four Golden Signals", "file_type": "concept", "source_file": "src/content/module-31/02-four-golden-signals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Google SRE's minimal metric set (Latency, Traffic, Errors, Saturation) every service should have on its main dashboard before service-specific metrics."}, {"id": "src_content_module_31_02_four_golden_signals_latency", "label": "Latency (Golden Signal)", "file_type": "concept", "source_file": "src/content/module-31/02-four-golden-signals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_31_02_four_golden_signals_traffic", "label": "Traffic (Golden Signal)", "file_type": "concept", "source_file": "src/content/module-31/02-four-golden-signals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_31_02_four_golden_signals_errors", "label": "Errors (Golden Signal)", "file_type": "concept", "source_file": "src/content/module-31/02-four-golden-signals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_31_02_four_golden_signals_saturation", "label": "Saturation (Golden Signal)", "file_type": "concept", "source_file": "src/content/module-31/02-four-golden-signals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_31_02_four_golden_signals_utilization_vs_saturation", "label": "Utilization vs Saturation", "file_type": "concept", "source_file": "src/content/module-31/02-four-golden-signals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Utilization is percent in use; saturation is whether the resource can take more work (growing queue length signals saturation even at 70% CPU)."}, {"id": "src_content_module_31_02_four_golden_signals_percentile_latency", "label": "p95/p99 Percentile Latency", "file_type": "concept", "source_file": "src/content/module-31/02-four-golden-signals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Averages hide outliers; percentiles reflect the experience of the worst-served users."}, {"id": "src_content_module_31_02_four_golden_signals_latency_averaging_trap", "label": "Latency Averaging Trap (success vs error)", "file_type": "rationale", "source_file": "src/content/module-31/02-four-golden-signals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Failed requests often fail fast, so blending them with successful latency makes numbers look better than reality; measure success latency separately and track error rate on its own."}], "edges": [{"source": "src_content_module_31_02_four_golden_signals_four_golden_signals", "target": "src_content_module_31_02_four_golden_signals_latency", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-31/02-four-golden-signals.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_31_02_four_golden_signals_four_golden_signals", "target": "src_content_module_31_02_four_golden_signals_traffic", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-31/02-four-golden-signals.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_31_02_four_golden_signals_four_golden_signals", "target": "src_content_module_31_02_four_golden_signals_errors", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "sou