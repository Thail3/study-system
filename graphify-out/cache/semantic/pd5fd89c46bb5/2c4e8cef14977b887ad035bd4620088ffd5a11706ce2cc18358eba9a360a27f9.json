{"nodes": [{"id": "src_content_module_35_01_dashboard_design_principles", "label": "Dashboard Design Principles", "file_type": "document", "source_file": "src/content/module-35/01-dashboard-design-principles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_35_01_dashboard_design_principles_golden_signals_on_top", "label": "Four Golden Signals at Top of Dashboard", "file_type": "rationale", "source_file": "src/content/module-35/01-dashboard-design-principles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Golden signals answer the first question everyone asks ('is it normal now?') fastest, so they sit above business-specific and debug panels."}, {"id": "src_content_module_35_01_dashboard_design_principles_viz_type_matching", "label": "Match Visualization Type to Question", "file_type": "rationale", "source_file": "src/content/module-35/01-dashboard-design-principles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Time-series for trends, single stat/gauge for current value vs threshold, heatmap for distributions, table/bar for comparisons. Trap: single stat of average latency hides p95/p99 detail; use multi-percentile time-series."}, {"id": "src_content_module_35_01_dashboard_design_principles_overview_dashboard", "label": "Overview Dashboard", "file_type": "concept", "source_file": "src/content/module-35/01-dashboard-design-principles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_35_01_dashboard_design_principles_drill_down_dashboard", "label": "Drill-down Dashboard", "file_type": "concept", "source_file": "src/content/module-35/01-dashboard-design-principles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_35_01_dashboard_design_principles_one_audience_per_dashboard", "label": "One Dashboard One Audience", "file_type": "rationale", "source_file": "src/content/module-35/01-dashboard-design-principles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A dashboard serving executives and on-call at once ends up used by nobody because each group scrolls past irrelevant panels; split into overview and drill-down."}, {"id": "src_content_module_35_01_dashboard_design_principles_dashboard_overload", "label": "Dashboard Overload", "file_type": "rationale", "source_file": "src/content/module-35/01-dashboard-design-principles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adding a panel for every new question yields 50+ panels nobody scans; people start ignoring important panels. Prune unused panels periodically."}], "edges": [{"source": "src_content_module_35_01_dashboard_design_principles", "target": "src_content_module_35_01_dashboard_design_principles_golden_signals_on_top", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-35/01-dashboard-design-principles.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_35_01_dashboard_design_principles", "target": "src_content_module_35_01_dashboard_design_principles_viz_type_matching", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-35/01-dashboard-design-principles.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_35_01_dashboard_design_principles", "target": "src_content_module_35_01_dashboard_design_principles_one_audience_per_dashboard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-35/01-dashboard-de