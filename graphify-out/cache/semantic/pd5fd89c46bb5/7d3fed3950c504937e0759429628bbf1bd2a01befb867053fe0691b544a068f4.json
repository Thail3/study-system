{"nodes": [{"id": "src_content_module_29_09_cicd_runner_pool_tragedy", "label": "Case: CI/CD Runner Pool Tragedy", "file_type": "document", "source_file": "src/content/module-29/09-cicd-runner-pool-tragedy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_29_09_cicd_runner_pool_tragedy_tragedy_of_the_commons", "label": "Tragedy of the Commons (CI Runner Pool)", "file_type": "concept", "source_file": "src/content/module-29/09-cicd-runner-pool-tragedy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each team has good reason to trigger pipelines more often but cost is spread over all teams; longer queues spur more retries (R loops merging at the shared pool)."}, {"id": "src_content_module_29_09_cicd_runner_pool_tragedy_runner_quota_per_team", "label": "Runner Quota per Team", "file_type": "concept", "source_file": "src/content/module-29/09-cicd-runner-pool-tragedy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Structure fix: overuse cost returns to the team causing it instead of being spread (chargeback idea)."}, {"id": "src_content_module_29_09_cicd_runner_pool_tragedy_org_wide_throughput_metric", "label": "Org-wide Delivery Throughput Metric", "file_type": "concept", "source_file": "src/content/module-29/09-cicd-runner-pool-tragedy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Goals fix: measure deployment frequency at company level so excess triggering is a cost to the metric each team optimizes."}], "edges": [{"source": "src_content_module_29_09_cicd_runner_pool_tragedy", "target": "src_content_module_28_03_mental_models_and_systems_iceberg_model", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "src/content/module-