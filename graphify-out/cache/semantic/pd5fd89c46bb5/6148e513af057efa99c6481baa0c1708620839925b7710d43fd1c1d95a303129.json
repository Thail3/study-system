{"nodes": [{"id": "src_content_module_06_05_stream_processing_stream_processing", "label": "Stream Processing", "file_type": "concept", "source_file": "src/content/module-06/05-stream-processing.md", "source_location": null, "rationale": "Continuous computation on messages as they flow, giving seconds-level freshness; results may need correction when late data arrives."}, {"id": "src_content_module_06_05_stream_processing_batch_processing", "label": "Batch Processing", "file_type": "concept", "source_file": "src/content/module-06/05-stream-processing.md", "source_location": null, "rationale": "Accumulate data then compute in one go: accurate and complete but slow; large systems usually run both stream and batch."}, {"id": "src_content_module_06_05_stream_processing_tumbling_window", "label": "Tumbling Window", "file_type": "concept", "source_file": "src/content/module-06/05-stream-processing.md", "source_location": null, "rationale": "Fixed non-overlapping time slices; each event belongs to exactly one window."}, {"id": "src_content_module_06_05_stream_processing_sliding_window", "label": "Sliding Window", "file_type": "concept", "source_file": "src/content/module-06/05-stream-processing.md", "source_location": null, "rationale": "Overlapping windows that advance continuously; good for moving averages and smooth trends."}, {"id": "src_content_module_06_05_stream_processing_watermark", "label": "Watermark", "file_type": "concept", "source_file": "src/content/module-06/05-stream-processing.md", "source_location": null, "rationale": "Wait a bit before closing a window so late events can still arrive, trading freshness for accuracy."}, {"id": "src_content_module_06_05_stream_processing_out_of_order_events", "label": "Out-of-Order Events", "file_type": "concept", "source_file": "src/content/module-06/05-stream-processing.md", "source_location": null, "rationale": "Network delay can make an earlier real-world event arrive after a later one, so closing windows immediately may drop late data."}, {"id": "src_content_module_06_05_stream_processing_exactly_once", "label": "Exactly-Once Semantics", "file_type": "concept", "source_file": "src/content/module-06/05-stream-processing.md", "source_location": null, "rationale": "Means the result equals processing once, not that the network never duplicates. Matters more than for REST because stateful aggregation accumulates error from duplicates over time."}, {"id": "src_content_module_06_05_stream_processing_checkpoint", "label": "State Checkpoint", "file_type": "concept", "source_file": "src/content/module-06/05-stream-processing.md", "source_location": null, "rationale": "Periodic snapshot of processing state plus atomic offset commit lets a crashed worker recover accurately."}, {"id": "src_content_module_06_05_stream_processing_kafka_streams_flink", "label": "Kafka Streams / Apache Flink", "file_type": "concept", "source_file": "src/content/module-06/05-stream-processing.md", "source_location": null}], "edges": [{"source": "src_content_module_06_05_stream_processing_stream_processing", "target": "src_content_module_06_03_pub_sub_pub_sub", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-06/05-stream-processing.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_06_05_stream_processing_stream_processing", "target": "src_content_module_06_02_message_queue_message_queue", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-06/05-stream-processing.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_06_05_stream_processing_stream_processing", "target": "src_content_module_06_05_stream_processing_batch_processing", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-06/05-stream-processing.md", "source_location": null, "weight": 1.0}, {"source": "src_c