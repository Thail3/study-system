{"nodes": [{"id": "src_content_module_05_02_pacelc_pacelc", "label": "PACELC", "file_type": "concept", "source_file": "src/content/module-05/02-pacelc.md", "source_location": null, "rationale": "Extends CAP: if Partition choose Availability or Consistency, Else choose Latency or Consistency. The Else case is far more common than partitions."}, {"id": "src_content_module_05_02_pacelc_latency_vs_consistency", "label": "Latency vs Consistency Trade-off (Else case)", "file_type": "rationale", "source_file": "src/content/module-05/02-pacelc.md", "source_location": null, "rationale": "Even with a healthy network, answering fast from local data trades off against checking other nodes for a fresher answer; matters mainly in multi-region deployments."}, {"id": "src_content_module_05_02_pacelc_speed_of_light_limit", "label": "Speed-of-Light Network Latency Limit", "file_type": "concept", "source_file": "src/content/module-05/02-pacelc.md", "source_location": null, "rationale": "Cross-continent round trips take at least roughly 100-200ms; within one data center under 1ms, so single-region systems rarely feel the L vs C trade-off."}, {"id": "src_content_module_05_02_pacelc_dynamodb", "label": "DynamoDB", "file_type": "concept", "source_file": "src/content/module-05/02-pacelc.md", "source_location": null, "rationale": "Chooses A on partition and L normally (speed first)."}, {"id": "src_content_module_05_02_pacelc_mongodb", "label": "MongoDB", "file_type": "concept", "source_file": "src/content/module-05/02-pacelc.md", "source_location": null, "rationale": "Default chooses C on partition and C normally (correctness first)."}, {"id": "src_content_module_05_02_pacelc_cassandra", "label": "Cassandra", "file_type": "concept", "source_file": "src/content/module-05/02-pacelc.md", "source_location": null, "rationale": "Tunable per query between favoring latency or consistency."}], "edges": [{"source": "src_content_module_05_02_pacelc_pacelc", "target": "src_content_module_05_01_cap_theo