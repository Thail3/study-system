{"nodes": [{"id": "src_content_module_51_01_cicd_pipeline_anatomy", "label": "CI/CD Pipeline Anatomy (lesson)", "file_type": "document", "source_file": "src/content/module-51/01-cicd-pipeline-anatomy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_51_01_cicd_pipeline_anatomy_cicd_pipeline", "label": "CI/CD Pipeline", "file_type": "rationale", "source_file": "src/content/module-51/01-cicd-pipeline-anatomy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Assembly line with quality gates (build, unit test, integration test, package, staging, production); failure at a gate stops the change so bugs are caught early where fixes are cheap."}, {"id": "src_content_module_51_01_cicd_pipeline_anatomy_pipeline_gate", "label": "Pipeline Gate", "file_type": "concept", "source_file": "src/content/module-51/01-cicd-pipeline-anatomy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_51_01_cicd_pipeline_anatomy_continuous_integration", "label": "Continuous Integration", "file_type": "concept", "source_file": "src/content/module-51/01-cicd-pipeline-anatomy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_51_01_cicd_pipeline_anatomy_continuous_delivery", "label": "Continuous Delivery", "file_type": "concept", "source_file": "src/content/module-51/01-cicd-pipeline-anatomy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_51_01_cicd_pipeline_anatomy_continuous_deployment", "label": "Continuous Deployment", "file_type": "concept", "source_file": "src/content/module-51/01-cicd-pipeline-anatomy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fully automated to production is not a goal for every team; teams with weak test coverage should stay at Continuous Delivery until automated gates reliably catch bugs."}, {"id": "src_content_module_51_01_cicd_pipeline_anatomy_build_once_deploy_many", "label": "Build Once, Deploy Many", "file_type": "rationale", "source_file": "src/content/module-51/01-cicd-pipeline-anatomy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Build a single artifact once and promote the same bytes through every environment; only config/env vars differ. Rebuilding per environment risks dependency drift and works-on-my-machine failures."}, {"id": "src_content_module_51_01_cicd_pipeline_anatomy_artifact", "label": "Single Immutable Artifact (image/binary)", "file_type": "concept", "source_file": "src/content/module-51/01-cicd-pipeline-anatomy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_51_01_cicd_pipeline_anatomy_pipeline_yaml_example", "label": "Build-once GitHub Actions Pipeline Example", "file_type": "code", "source_file": "src/content/module-51/01-cicd-pipeline-anatomy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_51_01_cicd_pipeline_anatomy_deployment_strategies", "label": "Deployment Strategies (blue-green, canary)", "file_type": "concept", "source_file": "src/content/module-51/01-cicd-pipeline-anatomy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_51_01_cicd_pipeline_anatomy_feedback_loop_length", "label": "Pipeline Feedback Loop Length", "file_type": "rationale", "source_file": "src/content/module-51/01-cicd-pipeline-anatomy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deploy frequency differs between teams because of feedback-loop length: broad automated tests make teams trust the gates, and build-once ensures the staging artifact is the production artifact."}], "edges": [{"source": "src_content_module_51_01_cicd_pipeline_anatomy", "target": "src_content_module_51_01_cicd_pipeline_anatomy_cicd_pipeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-51/01-cicd-pipeline-anatomy.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_51_01_cicd_pipeline_anatomy_cicd_pipeline", "target": "src_content_module_51_01_cicd_pipeline_anatomy_pipeline_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-51/01-cicd-pipeline-anatomy.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_51_01_cicd_pipeline_anatomy_cicd_pipeline", "target": "src_content_module_51_01_cicd_pipeline_anatomy_continuous_integration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-51/01-cicd-pipeline-anatomy.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_51_01_cicd_pipeline_anatomy_continuous_delivery", "target": "src_content_module_51_01_cicd_pipeline_anatomy_continuous_integration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-51/01-cicd-pipeline-anatomy.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_51_01_cicd_pipeline_anatomy_continuous_deployment", "target": "src_content_module_51_01_cicd_pipeline_anatomy_continuous_delivery", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-51/01-cicd-pipeline-anatomy.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_51_01_cicd_pipeline_a