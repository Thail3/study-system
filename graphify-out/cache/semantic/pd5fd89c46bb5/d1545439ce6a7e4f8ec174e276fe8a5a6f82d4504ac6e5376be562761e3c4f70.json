{"nodes": [{"id": "src_content_module_53_02_continuous_profiling", "label": "Continuous Profiling (lesson)", "file_type": "document", "source_file": "src/content/module-53/02-continuous-profiling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_53_02_continuous_profiling_continuous_profiling", "label": "Continuous Profiling", "file_type": "rationale", "source_file": "src/content/module-53/02-continuous-profiling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Always-on low-overhead sampling profiling in production, retaining flame graphs for before/after comparison to find regressions that only appear in production."}, {"id": "src_content_module_53_02_continuous_profiling_sampling_profiler", "label": "Sampling Profiler", "file_type": "rationale", "source_file": "src/content/module-53/02-continuous-profiling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trades 100% fidelity for very low overhead by sampling call stacks periodically (e.g. every 10ms); slow functions are sampled more often so results are statistically accurate."}, {"id": "src_content_module_53_02_continuous_profiling_flame_graph", "label": "Flame Graph", "file_type": "concept", "source_file": "src/content/module-53/02-continuous-profiling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_53_02_continuous_profiling_traditional_profiling", "label": "Traditional Profiling", "file_type": "concept", "source_file": "src/content/module-53/02-continuous-profiling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_53_02_continuous_profiling_metric_trace_profile_ladder", "label": "Metric to Trace to Profile Inve