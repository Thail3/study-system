{"nodes": [{"id": "src_content_module_08_07_deployment_strategies_deployment_strategies", "label": "Deployment Strategies", "file_type": "concept", "source_file": "src/content/module-08/07-deployment-strategies.md", "source_location": null, "rationale": "Failures caused by our own new releases are the most dangerous, so choose a rollout method that limits blast radius and allows fast rollback."}, {"id": "src_content_module_08_07_deployment_strategies_big_bang", "label": "Big Bang Deployment", "file_type": "concept", "source_file": "src/content/module-08/07-deployment-strategies.md", "source_location": null, "rationale": "Replace everything at once: lowest cost, but 100% of users hit a bug immediately and rollback needs downtime."}, {"id": "src_content_module_08_07_deployment_strategies_rolling", "label": "Rolling Deployment", "file_type": "concept", "source_file": "src/content/module-08/07-deployment-strategies.md", "source_location": null, "rationale": "Replace instances gradually with no downtime; v1 and v2 run together so APIs and schemas must be backward compatible."}, {"id": "src_content_module_08_07_deployment_strategies_blue_green", "label": "Blue-Green Deployment", "file_type": "concept", "source_file": "src/content/module-08/07-deployment-strategies.md", "source_location": null, "rationale": "Two identical environments with one traffic switch; very fast rollback but double the resources."}, {"id": "src_content_module_08_07_deployment_strategies_canary", "label": "Canary Deployment", "file_type": "concept", "source_file": "src/content/module-08/07-deployment-strategies.md", "source_location": null, "rationale": "Release to a small percentage first and watch metrics (error rate, latency) before expanding or rolling back; depends on good observability."}, {"id": "src_content_module_08_07_deployment_strategies_feature_flag", "label": "Feature Flag (Dark Launch)", "file_type": "rationale", "source_file": "src/content/module-08/07-deployment-strategies.md", "source_location": null, "rationale": "Separates deploy from release: code ships dark behind a flag and is enabled per business rule without redeploying; downside is flag debt if old flags are not removed."}], "edges": [{"source": "src_content_module_08_07_deployment_strategies_deployment_strategies", "target": "src_content_module_08_07_deployment_strategies_big_bang", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/07-deployment-strategies.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_07_deployment_strategies_deployment_strategies", "target": "src_content_module_08_07_deployment_strategies_rolling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/07-deployment-strategies.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_07_deployment_strategies_deployment_strategies", "target": "src_content_module_08_07_deployment_strategies_blue_green", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/07-deployment-strategies.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_07_deployment_strategies_deployment_strategies", "target": "src_content_module_08_07_deployment_strategies_canary", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/07-deployment-strategies.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_07_deployment_strategies_canary", "target": "src_content_module_08_05_observability_observability", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/07-deployment-strategies.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_07_deployment_strategies_canary", "target": "src_content_module_08_05_observability_metric", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/07-deployment-strategies.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_07_deployment_strategies_feature_flag", "target": "src_content_module_08_07_deployment_strategies_canary", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/07-deployment-strategies.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_07_deployment_strategies_blue_green", "target": "src_content_module_08_04_failover_redundancy_active_passive", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "src/content/module-08/07-deployment-strategies.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "module_08_reliability_toolkit", "label": "Module 08 Reliability Toolkit (Rate Limit, Circuit Breaker, Retry, Failover, Observability, Idempotency)", "nodes": ["src_content_module_08_01_rate_limiting_rate_limiting", "src_content_module_08_02_circuit_breaker_circuit_breaker", "src_content_module_08_03_retry_backoff_retry", "src_content_module_08_04_failover_redundancy_failover", "src_content_module_08_05_observability_observability", "src_content_module_08_06_idempotency_idempotency"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/07-deployment-strategies.md"}]}