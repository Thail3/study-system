{"nodes": [{"id": "src_content_module_08_01_rate_limiting_rate_limiting", "label": "Rate Limiting", "file_type": "concept", "source_file": "src/content/module-08/01-rate-limiting.md", "source_location": null, "rationale": "Caps requests per time window so one client cannot exhaust the system; placed at the gateway or load balancer so rejected traffic never reaches the database."}, {"id": "src_content_module_08_01_rate_limiting_token_bucket", "label": "Token Bucket", "file_type": "rationale", "source_file": "src/content/module-08/01-rate-limiting.md", "source_location": null, "rationale": "Tokens refill at a fixed rate up to a cap; each request spends one, allowing controlled bursts and reducing boundary spikes."}, {"id": "src_content_module_08_01_rate_limiting_boundary_spike", "label": "Boundary Spike (Fixed Window Flaw)", "file_type": "concept", "source_file": "src/content/module-08/01-rate-limiting.md", "source_location": null, "rationale": "With a fixed 100/sec window a client can send 100 at the end of one window and 100 at the start of the next, giving 200 within one real second."}, {"id": "src_content_module_08_01_rate_limiting_sliding_window_counter", "label": "Sliding Window Counter", "file_type": "rationale", "source_file": "src/content/module-08/01-rate-limiting.md", "source_location": null, "rationale": "Weights the previous window by elapsed fraction of the current one for a smooth, more accurate count at the cost of slightly more complex logic; suited to billing APIs."}, {"id": "src_content_module_08_01_rate_limiting_rate_limit_levels", "label": "Per-User / Per-IP / Global Limits", "file_type": "concept", "source_file": "src/content/module-08/01-rate-limiting.md", "source_location": null}], "edges": [{"source": "src_content_module_08_01_rate_limiting_rate_limiting", "target": "src_content_module_08_01_rate_limiting_token_bucket", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/01-rate-limiting.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_01_rate_limiting_rate_limiting", "target": "src_content_module_08_01_rate_limiting_rate_limit_levels", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/01-rate-limiting.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_01_rate_limiting_rate_limiting", "target": "src_content_module_07_03_api_gateway_api_gateway", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/01-rate-limiting.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_01_rate_limiting_boundary_spike", "target": "src_content_module_08_01_rate_limiting_token_bucket", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/01-rate-limiting.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_01_rate_limiting_boundary_spike", "target": "src_content_module_08_01_rate_limiting_sliding_window_counter", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/01-rate-limiting.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_01_rate_limiting_sliding_window_counter", "target": "src_content_module_08_01_rate_limiting_token_bucket", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/01-rate-limiting.md", "source_location": null, "weight": 1.0}], "hyperedges": []}