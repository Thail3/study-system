{"nodes": [{"id": "src_content_module_36_02_alert_fatigue", "label": "Alert Fatigue", "file_type": "document", "source_file": "src/content/module-36/02-alert-fatigue.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_36_02_alert_fatigue_alert_fatigue", "label": "Alert Fatigue", "file_type": "concept", "source_file": "src/content/module-36/02-alert-fatigue.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non-actionable, frequently firing alerts cause people to ignore notifications, so genuinely important alerts get ignored too (car alarm in the wind analogy)."}, {"id": "src_content_module_36_02_alert_fatigue_actionable_alert_principle", "label": "Every Alert Must Be Actionable", "file_type": "rationale", "source_file": "src/content/module-36/02-alert-fatigue.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An alert that wakes someone at night must have something they can do immediately; otherwise downgrade to a dashboard or ticket."}, {"id": "src_content_module_36_02_alert_fatigue_alert_severity_levels", "label": "Alert Severity Levels (Page, Ticket, Dashboard)", "file_type": "concept", "source_file": "src/content/module-36/02-alert-fatigue.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_36_02_alert_fatigue_runbook", "label": "Runbook", "file_type": "concept", "source_file": "src/content/module-36/02-alert-fatigue.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Short per-alert document with first checks and escalation, linking to relevant dashboards, reducing thinking time when woken at night."}, {"id": "src_content_module_36_02_alert_fatigue_over_paging_antipattern", "label": "Everything-Is-a-Page Anti-pattern", "file_type": "rationale", "source_file": "src/content/module-36/02-alert-fatigue.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New teams set all alerts to Page 'just in case', exhausting on-call so real incidents get slow response or muted alerts."}], "edges": [{"source": "src_content_module_36_02_alert_fatigue", "target": "src_content_module_36_02_alert_fatigue_alert_fatigue", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-36/02-alert-fatigue.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_36_02_alert_fatigue_alert_fatigue", "target": "src_content_module_36_02_alert_fatigue_actionable_alert_principle", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-36/02-alert-fatigue.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_36_02_alert_fatigue_actionable_alert_principle", "target": "src_content_module_36_01_error_budget_burn_rate_multi_window_alerting", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-36/02-alert-fatigue.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_36_02_alert_fatigue_alert_severity_levels", "target": "src_content_module_36_02_alert_fatigue_actionable_alert_principle", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-36/02-alert-fatigue.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_36_02_alert_fatigue_alert_severity_levels", "target": "src_content_module_36_03_on_call_and_paging_on_call", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-36/02-alert-fatigue.md", "source_location": null, "weight": 1.0}, {"source"