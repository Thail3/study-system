{"nodes": [{"id": "src_content_module_30_01_zero_trust_architecture_zero_trust_architecture", "label": "Zero Trust Architecture", "file_type": "rationale", "source_file": "src/content/module-30/01-zero-trust-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never trust, always verify: unit of trust shifts from network location to identity + context of each request, because one breached point otherwise allows free lateral movement."}, {"id": "src_content_module_30_01_zero_trust_architecture_castle_and_moat_model", "label": "Castle-and-Moat Security Model", "file_type": "concept", "source_file": "src/content/module-30/01-zero-trust-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Perimeter (firewall/VPN) trust model: anyone inside the network is trusted; low overhead but a single credential leak exposes everything."}, {"id": "src_content_module_30_01_zero_trust_architecture_lateral_movement", "label": "Lateral Movement", "file_type": "concept", "source_file": "src/content/module-30/01-zero-trust-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_30_01_zero_trust_architecture_policy_decision_point", "label": "Policy Decision Point (PDP)", "file_type": "concept", "source_file": "src/content/module-30/01-zero-trust-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_30_01_zero_trust_architecture_mutual_tls", "label": "Mutual TLS (mTLS)", "file_type": "concept", "source_file": "src/content/module-30/01-zero-trust-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_30_01_zero_trust_architecture_adr_mtls_between_interna