{"nodes": [{"id": "src_content_module_48_03_command_and_state", "label": "Command and State (lesson)", "file_type": "document", "source_file": "src/content/module-48/03-command-and-state.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_48_03_command_and_state_command_pattern", "label": "Command Pattern", "file_type": "rationale", "source_file": "src/content/module-48/03-command-and-state.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wraps a method call as an object with execute() and undo(), enabling queuing, logging (audit trail) and undo/redo instead of direct calls."}, {"id": "src_content_module_48_03_command_and_state_state_pattern", "label": "State Pattern", "file_type": "rationale", "source_file": "src/content/module-48/03-command-and-state.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Moves per-state behavior into separate state classes, removing scattered if-else state checks; each state object knows its own next state, which is what distinguishes it from plain Strategy."}, {"id": "src_content_module_48_03_command_and_state_command", "label": "Command (interface)", "file_type": "code", "source_file": "src/content/module-48/03-command-and-state.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_48_03_command_and_state_trafficlight", "label": "TrafficLight", "file_type": "code", "source_file": "src/content/module-48/03-command-and-state.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_48_03_command_and_state_trafficlightstate", "label": "TrafficLightState", "file_type": "code", "source_file": "src/content/module-48/03-command-and-state.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_48_03_command_and_state_undo_complexity", "label": "Command undo() Needs Prior State", "file_type": "rationale", "source_file": "src/content/module-48/03-command-and-state.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Correct undo requires storing the previous state (e.g. deleted value and its original index), not just calling the opposite method; gets harder when a command affects several objects."}], "edges": [{"source": "src_content_module_48_03_command_and_state", "target": "src_content_module_48_03_command_and_state_command_pattern", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-48/03-command-and-state.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_48_03_command_and_state", "target": "src_content_module_48_03_command_and_state_state_pattern", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-48/03-command-and-state.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_48_03_command_and_state_command", "target": "src_content_module_48_03_command_and_state_command_pattern", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-48/03-command-and-state.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_48_03_command_and_state_trafficlightstate", "target": "src_content_module_48_03_command_and_state_state_pattern", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-48/03-command-and-state.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_48_03_command_and_state_trafficlight", "target": "src_content_module_48_03_command_and_state