{"nodes": [{"id": "src_content_module_31_01_monitoring_vs_observability_monitoring", "label": "Monitoring", "file_type": "concept", "source_file": "src/content/module-31/01-monitoring-vs-observability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Answers questions known in advance via fixed dashboards and alerts (like an annual health checkup)."}, {"id": "src_content_module_31_01_monitoring_vs_observability_observability", "label": "Observability", "file_type": "concept", "source_file": "src/content/module-31/01-monitoring-vs-observability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets you ask new questions during investigation via ad-hoc queries over raw high-cardinality events; having logs/metrics/traces alone does not make a system observable."}, {"id": "src_content_module_31_01_monitoring_vs_observability_known_unknowns", "label": "Known-Unknowns", "file_type": "concept", "source_file": "src/content/module-31/01-monitoring-vs-observability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_31_01_monitoring_vs_observability_unknown_unknowns", "label": "Unknown-Unknowns", "file_type": "concept", "source_file": "src/content/module-31/01-monitoring-vs-observability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_31_01_monitoring_vs_observability_high_cardinality_data", "label": "High-Cardinality Data", "file_type": "concept", "source_file": "src/content/module-31/01-monitoring-vs-observability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fields with many unique values (user_id, request_id) enable slicing raw events by many dimensions to find unexpected patterns."}, {"