{"nodes": [{"id": "src_content_module_08_06_idempotency_idempotency", "label": "Idempotency", "file_type": "concept", "source_file": "src/content/module-08/06-idempotency.md", "source_location": null, "rationale": "Repeating an operation leaves the same final result; essential because retries and at-least-once delivery cause duplicates."}, {"id": "src_content_module_08_06_idempotency_idempotency_key", "label": "Idempotency Key", "file_type": "rationale", "source_file": "src/content/module-08/06-idempotency.md", "source_location": null, "rationale": "Client-generated key tied to one intent and sent on every retry; the server checks it atomically and returns the stored result instead of repeating work. Needs a TTL and an atomic check-then-write to avoid races."}, {"id": "src_content_module_08_06_idempotency_dedup_store", "label": "Dedup Store", "file_type": "concept", "source_file": "src/content/module-08/06-idempotency.md", "source_location": null}, {"id": "src_content_module_08_06_idempotency_http_method_idempotency", "label": "HTTP Method Idempotency (GET/PUT/DELETE vs POST)", "file_type": "concept", "source_file": "src/content/module-08/06-idempotency.md", "source_location": null, "rationale": "GET, PUT and usually DELETE are idempotent; POST is not, so it needs added protection."}, {"id": "src_content_module_08_06_idempotency_naturally_idempotent", "label": "Naturally Idempotent Design", "file_type": "rationale", "source_file": "src/content/module-08/06-idempotency.md", "source_location": null, "rationale": "Make operations idempotent by design: use set-to-value instead of increment, and database unique constraints on client-supplied IDs."}, {"id": "src_content_module_08_06_idempotency_unique_constraint", "label": "Database Unique Constraint Deduplication", "file_type": "concept", "source_file": "src/content/module-08/06-idempotency.md", "source_location": null}, {"id": "src_content_module_08_06_idempotency_double_charge", "label": "Duplicate Charge from Retry", "file_type": "concept", "source_file": "src/content/module-08/06-idempotency.md", "source_location": null, "rationale": "The first request succeeded but the response was lost, so a naive retry charges the customer twice."}], "edges": [{"source": "src_content_module_08_06_idempotency_idempotency", "target": "src_content_module_08_03_retry_backoff_retry", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/06-idempotency.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_06_idempotency_idempotency", "target": "src_content_module_08_03_retry_backoff_exponential_backoff", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/06-idempotency.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_06_idempotency_double_charge", "target": "src_content_module_08_06_idempotency_idempotency_key", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/06-idempotency.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_06_idempotency_idempotency_key", "target": "src_content_module_08_06_idempotency_dedup_store", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/06-idempotency.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_06_idempotency_http_method_idempotency", "target": "src_content_module_08_06_idempotency_idempotency", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-08/06-idempotency.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_08_06_idempotency_idempotency_key", "target": "src_content_module_08_06_idempotency_idempotency", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "s