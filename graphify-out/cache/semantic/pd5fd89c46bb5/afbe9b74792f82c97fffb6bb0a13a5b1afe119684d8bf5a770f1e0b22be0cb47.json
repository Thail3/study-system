{"nodes": [{"id": "src_content_module_03_01_why_cache", "label": "Why cache", "file_type": "document", "source_file": "src/content/module-03/01-why-cache.md"}, {"id": "src_content_module_03_01_why_cache_cache", "label": "Cache", "file_type": "concept", "source_file": "src/content/module-03/01-why-cache.md"}, {"id": "src_content_module_03_01_why_cache_hit_miss", "label": "Cache Hit / Miss flow", "file_type": "concept", "source_file": "src/content/module-03/01-why-cache.md"}, {"id": "src_content_module_03_01_why_cache_cache_worthiness", "label": "What is worth caching", "file_type": "rationale", "source_file": "src/content/module-03/01-why-cache.md", "rationale": "read-heavy data (read more than changed), expensive to compute, and tolerant of slightly stale values"}, {"id": "src_content_module_03_01_why_cache_invalidation_is_hard", "label": "Cache invalidation is hard", "file_type": "concept", "source_file": "src/content/module-03/01-why-cache.md", "rationale": "knowing when to update the cached copy is harder than it looks; the industry jokes that it is one of two hard problems"}, {"id": "src_content_module_03_01_why_cache_write_through", "label": "Write-Through", "file_type": "concept", "source_file": "src/content/module-03/01-why-cache.md", "rationale": "write cache and DB together before acknowledging; always consistent but slower; suited to banking"}, {"id": "src_content_module_03_01_why_cache_write_back", "label": "Write-Back (Write-Behind)", "file_type": "concept", "source_file": "src/content/module-03/01-why-cache.md", "rationale": "write cache, acknowledge, sync DB later; fast but data is lost if the cache dies before syncing; fine for view counts or light analytics"}, {"id": "src_content_module_03_01_why_cache_write_around", "label": "Write-Around", "file_type": "concept", "source_file": "src/content/module-03/01-why-cache.md"}], "edges": [{"source": "src_content_module_03_01_why_cache", "target": "src_content_module_03_01_why_cache_cache", "relation": "refe