{"nodes": [{"id": "src_content_module_29_03_cascading_failure_reinforcing_loop", "label": "Case: Cascading Failure and Reinforcing Loop", "file_type": "document", "source_file": "src/content/module-29/03-cascading-failure-reinforcing-loop.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_module_29_03_cascading_failure_reinforcing_loop_cascading_failure", "label": "Cascading Failure (Retry Storm)", "file_type": "concept", "source_file": "src/content/module-29/03-cascading-failure-reinforcing-loop.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retries add load, raising latency/errors, triggering more retries (R loop); alerting delay hides it until full outage."}, {"id": "src_content_module_29_03_cascading_failure_reinforcing_loop_shared_database_hidden_dependency", "label": "Shared Database Hidden Dependency", "file_type": "concept", "source_file": "src/content/module-29/03-cascading-failure-reinforcing-loop.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "payment-service and auth-service share a database so failure cascades despite no code-level dependency; the team's boundary was too narrow."}, {"id": "src_content_module_29_03_cascading_failure_reinforcing_loop_circuit_breaker", "label": "Circuit Breaker", "file_type": "concept", "source_file": "src/content/module-29/03-cascading-failure-reinforcing-loop.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cuts the errors->retries link by stopping retries once error rate exceeds a threshold."}, {"id": "src_content_module_29_03_cascading_failure_reinforcing_loop_bulkhead_pattern", "label": "Bulkhead Pattern", "file_type": "concept", "source_file": "src/content/module-29/03-cascading-failure-reinforcing-loop.md", "source_locati