ilt circuit breakers or tested retry behavior across the whole call graph."}], "edges": [{"source": "src_content_module_29_03_cascading_failure_reinforcing_loop", "target": "src_content_module_28_03_mental_models_and_systems_iceberg_model", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "src/content/module-29/03-cascading-failure-reinforcing-loop.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_29_03_cascading_failure_reinforcing_loop", "target": "src_content_module_29_03_cascading_failure_reinforcing_loop_cascading_failure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-29/03-cascading-failure-reinforcing-loop.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_29_03_cascading_failure_reinforcing_loop_cascading_failure", "target": "src_content_module_29_03_cascading_failure_reinforcing_loop_shared_database_hidden_dependency", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-29/03-cascading-failure-reinforcing-loop.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_29_03_cascading_failure_reinforcing_loop_shared_database_hidden_dependency", "target": "src_content_module_28_02_boundary_problem_system_boundary", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-29/03-cascading-failure-reinforcing-loop.md", "source_location": null, "weight": 1.0}, {"source": "src_content_module_29_03_cascading_failure_reinforcing_loop_circuit_breaker", "target": "src_content_module_29_03_cascading_failure_reinforcing_loop_cascading_failure", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/module-29/03-cascading-failure-reinforcing-loop.md", "source_location": null, "weight": 1.0}, {"source"